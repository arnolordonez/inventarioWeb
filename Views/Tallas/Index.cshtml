@model InventarioWEB.ViewModels.Catalogos.Tallas.TallasIndexVM

@{
    ViewData["Title"] = "Tallas";
}

<h2 class="mb-3">Tallas</h2>

<p>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Talla
    </a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Descripción</th>
            <th>Género</th>
            <th style="width:150px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Tallas.Any())
        {
            foreach (var item in Model.Tallas)
            {
                <tr>
                    <td>@item.DescripTalla</td>
                    <td>@item.Genero</td>
                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@item.ID_Tallas"
                           class="btn btn-sm btn-warning">
                            Editar
                        </a>

                        <a asp-action="Eliminar"
                           asp-route-id="@item.ID_Tallas"
                           class="btn btn-sm btn-danger">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    No hay tallas registradas.
                </td>
            </tr>
        }
    </tbody>
</table>
