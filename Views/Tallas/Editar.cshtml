@model InventarioWEB.ViewModels.Catalogos.Tallas.TallaEditVM

@{
    ViewData["Title"] = "Editar Talla";
}

<h2 class="mb-3">Editar Talla</h2>

<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="ID_Tallas" />

    <div class="mb-3">
        <label asp-for="DescripTalla" class="form-label"></label>
        <input asp-for="DescripTalla" class="form-control" />
        <span asp-validation-for="DescripTalla" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ID_Genero" class="form-label"></label>
        <select asp-for="ID_Genero"
                asp-items="Model.Generos"
                class="form-select">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="ID_Genero" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
