@{
    ViewData["Title"] = "Abonos - Indomable";
}

<div class="container mt-4">

    <h3 class="mb-4">
        💰 Registro de Abonos
    </h3>

    <!-- ===================================================== -->
    <!-- 🔹 BUSCAR CLIENTE -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Buscar Cliente
            </h5>

            <div class="row g-2">

                <div class="col-md-10">
                    <input type="text"
                           id="txtBuscarCliente"
                           class="form-control"
                           placeholder="Buscar por nombre o cédula" />
                </div>

                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary"
                            onclick="buscarCliente()">
                        Buscar
                    </button>
                </div>

            </div>

            <div id="listaClientes" class="mt-3"></div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 CLIENTE SELECCIONADO -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4 d-none" id="cardCliente">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Cliente Seleccionado
            </h5>

            <div class="row">

                <div class="col-md-6">
                    <strong>Cliente:</strong>
                    <div id="clienteNombre"></div>
                </div>

                <div class="col-md-6">
                    <strong>Cédula:</strong>
                    <div id="clienteCedula"></div>
                </div>

            </div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 PEDIDOS PENDIENTES -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4 d-none" id="cardPedidos">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Pedidos Pendientes
            </h5>

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Pedido</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Saldo</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th style="width:120px;">Acción</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyPedidos"></tbody>

                </table>

            </div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 DETALLE PEDIDO -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4 d-none" id="cardDetalle">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="card-title m-0">
                    Detalle Pedido
                </h5>

                <div>
                    <strong>Pedido:</strong>
                    <span id="detallePedidoId"></span>
                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-striped table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Talla</th>
                            <th>Color</th>
                            <th>Docenas</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyDetalle"></tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<!-- ===================================================== -->
<!-- 🔹 MODAL ABONO -->
<!-- ===================================================== -->

<div class="modal fade" id="modalAbono" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Registrar Abono
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden" id="ID_Pedido" />

                <div class="mb-3">

                    <label class="form-label">
                        Saldo pendiente
                    </label>

                    <input type="text"
                           id="saldoPendiente"
                           class="form-control"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Monto a pagar
                    </label>

                    <input type="number"
                           id="Monto"
                           class="form-control"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Método de pago
                    </label>

                    <select id="MetodoPago" class="form-select">
                        <option value="">
                            Cargando...
                        </option>
                    </select>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-success"
                        onclick="guardarAbono()">
                    Guardar Abono
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        let clienteSeleccionado = null;

        // =====================================================
        // 🔹 BUSCAR CLIENTE
        // =====================================================

        async function buscarCliente() {

            const term = document.getElementById("txtBuscarCliente").value;

            if (!term.trim()) {
                return;
            }

            const response = await fetch(`/Abonos/BuscarClientes?term=${encodeURIComponent(term)}`);
            const data = await response.json();

            let html = '';

            if (data.length === 0) {

                html = `
                    <div class="alert alert-warning">
                        No se encontraron clientes.
                    </div>
                `;
            }
            else {

                html += `
                    <div class="list-group">
                `;

                data.forEach(c => {

                    html += `
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                onclick='seleccionarCliente(${JSON.stringify(c)})'>

                            <strong>${c.nombreCompleto}</strong>
                            <br>
                            <small>Cédula: ${c.cedula}</small>

                        </button>
                    `;
                });

                html += `</div>`;
            }

            document.getElementById("listaClientes").innerHTML = html;
        }

        // =====================================================
        // 🔹 SELECCIONAR CLIENTE
        // =====================================================

        async function seleccionarCliente(cliente) {

            clienteSeleccionado = cliente;

            document.getElementById("clienteNombre").innerText = cliente.nombreCompleto;
            document.getElementById("clienteCedula").innerText = cliente.cedula;

            document.getElementById("cardCliente")
                .classList.remove("d-none");

            document.getElementById("listaClientes").innerHTML = "";

            await cargarPedidos(cliente.id_Cliente);
        }

        // =====================================================
        // 🔹 CARGAR PEDIDOS
        // =====================================================

        async function cargarPedidos(idCliente) {

            const response = await fetch(`/Abonos/ObtenerPedidosPendientes?idCliente=${idCliente}`);
            const data = await response.json();

            const tbody = document.getElementById("tbodyPedidos");

            tbody.innerHTML = "";

            if (data.length === 0) {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            El cliente no tiene pedidos pendientes.
                        </td>
                    </tr>
                `;
            }
            else {

                data.forEach(p => {

                    tbody.innerHTML += `
                        <tr>
                            <td>${p.id_Pedido}</td>
                            <td>${p.fecha}</td>
                            <td>$ ${Number(p.totalVenta).toLocaleString()}</td>
                            <td class="fw-bold text-danger">
                                $ ${Number(p.saldo).toLocaleString()}
                            </td>
                            <td>${p.tipoVenta}</td>
                            <td>${p.estadoPago}</td>

                            <td>
                                <button class="btn btn-success btn-sm"
                                        onclick="abrirModalAbono(${p.id_Pedido}, ${p.saldo})">

                                    Abonar

                                </button>
                            </td>
                        </tr>
                    `;
                });
            }

            document.getElementById("cardPedidos")
                .classList.remove("d-none");
        }

        // =====================================================
        // 🔹 ABRIR MODAL
        // =====================================================

        async function abrirModalAbono(idPedido, saldo) {

            document.getElementById("ID_Pedido").value = idPedido;

            document.getElementById("saldoPendiente").value = saldo;

            document.getElementById("Monto").value = saldo;

            await cargarMetodosPago();

            await cargarDetallePedido(idPedido);

            const modal = new bootstrap.Modal(
                document.getElementById('modalAbono')
            );

            modal.show();
        }

        // =====================================================
        // 🔹 MÉTODOS PAGO
        // =====================================================

        async function cargarMetodosPago() {

            const response = await fetch('/Abonos/ObtenerMetodosPago');
            const data = await response.json();

            const select = document.getElementById("MetodoPago");

            select.innerHTML = `
                <option value="">
                    Seleccione...
                </option>
            `;

            data.forEach(m => {

                select.innerHTML += `
                    <option value="${m.value}">
                        ${m.text}
                    </option>
                `;
            });
        }

        // =====================================================
        // 🔹 DETALLE PEDIDO
        // =====================================================

        async function cargarDetallePedido(idPedido) {

            const response = await fetch(`/Abonos/ObtenerDetallePedido?idPedido=${idPedido}`);
            const data = await response.json();

            const tbody = document.getElementById("tbodyDetalle");

            tbody.innerHTML = "";

            data.forEach(d => {

                tbody.innerHTML += `
                    <tr>
                        <td>${d.producto}</td>
                        <td>${d.talla}</td>
                        <td>${d.color}</td>
                        <td>${d.cantidad}</td>
                        <td>$ ${Number(d.subtotal).toLocaleString()}</td>
                    </tr>
                `;
            });

            document.getElementById("detallePedidoId").innerText = idPedido;

            document.getElementById("cardDetalle")
                .classList.remove("d-none");
        }

        // =====================================================
        // 🔹 GUARDAR ABONO
        // =====================================================

        async function guardarAbono() {

            const data = {

                ID_Pedido: parseInt(
                    document.getElementById("ID_Pedido").value
                ),

                Monto: parseFloat(
                    document.getElementById("Monto").value
                ),

                ID_MetodoPago: parseInt(
                    document.getElementById("MetodoPago").value
                )
            };

            if (!data.ID_MetodoPago) {

                alert("Seleccione un método de pago.");
                return;
            }

            const response = await fetch('/Abonos/Crear', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(data)
            });

            if (!response.ok) {

                const error = await response.text();

                alert(error);

                return;
            }

            const result = await response.json();

            alert(result.mensaje);

            location.reload();
        }

    </script>
}