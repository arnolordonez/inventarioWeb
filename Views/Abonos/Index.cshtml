@{
    ViewData["Title"] = "Abonos - Indomable";
}

<div class="container mt-4">

    <h3 class="mb-4">
        💰 Registro de Abonos
    </h3>

    <!-- ===================================================== -->
    <!-- 🔹 BUSCAR CLIENTE -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Buscar Cliente
            </h5>

            <div class="row g-2">

                <div class="col-md-10">
                    <input type="text"
                           id="txtBuscarCliente"
                           class="form-control"
                           placeholder="Buscar por nombre o cédula" />
                </div>

                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary"
                            onclick="buscarCliente()">
                        Buscar
                    </button>
                </div>

            </div>

            <div id="listaClientes" class="mt-3"></div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 CLIENTE -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4 d-none" id="cardCliente">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Cliente Seleccionado
            </h5>

            <div class="row">

                <div class="col-md-6">
                    <strong>Cliente:</strong>
                    <div id="clienteNombre"></div>
                </div>

                <div class="col-md-6">
                    <strong>Cédula:</strong>
                    <div id="clienteCedula"></div>
                </div>

            </div>

        </div>
    </div>


    <!-- ===================================================== -->
    <!-- 🔹 RESUMEN FINANCIERO DEL PEDIDO -->
    <!-- ===================================================== -->
    <!--
        OBJETIVO:
        Mostrar un resumen financiero consolidado del pedido
        seleccionado antes del historial de abonos.

        Este panel permite visualizar rápidamente:

        - Total de la venta
        - Total abonado por el cliente
        - Saldo pendiente por cobrar
        - Estado actual del pago (ABONADO / PAGADO)

        Los valores se cargan dinámicamente desde:
        AbonosController.ObtenerResumenPedido(idPedido)

        Función Javascript:
        cargarResumenPedido(idPedido)

        Se visualiza al presionar el botón "Ver"
        en la tabla de Pedidos con Saldo Pendiente.
    -->
    <div class="card shadow-sm mb-4 d-none"
         id="cardResumenFinanciero">

        <div class="card-body">

            <h5 class="card-title mb-4">
                Resumen Financiero del Pedido
            </h5>

            <div class="row">

                <!-- ========================================= -->
                <!-- 🔹 TOTAL VENTA -->
                <!-- ========================================= -->
                <div class="col-md-3 mb-3">

                    <div class="border rounded p-3 text-center bg-light">

                        <small class="text-muted">
                            Total Venta
                        </small>

                        <h4 class="mt-2 mb-0 text-primary"
                            id="lblTotalVenta">
                            $0
                        </h4>

                    </div>

                </div>

                <!-- ========================================= -->
                <!-- 🔹 TOTAL ABONADO -->
                <!-- ========================================= -->
                <div class="col-md-3 mb-3">

                    <div class="border rounded p-3 text-center bg-light">

                        <small class="text-muted">
                            Total Abonado
                        </small>

                        <h4 class="mt-2 mb-0 text-success"
                            id="lblTotalAbonado">
                            $0
                        </h4>

                    </div>

                </div>

                <!-- ========================================= -->
                <!-- 🔹 SALDO PENDIENTE -->
                <!-- ========================================= -->
                <div class="col-md-3 mb-3">

                    <div class="border rounded p-3 text-center bg-light">

                        <small class="text-muted">
                            Saldo Pendiente
                        </small>

                        <div id="lblSaldoPendiente" class="mt-2">
                        </div>

                    </div>

                </div>

                <!-- ========================================= -->
                <!-- 🔹 ESTADO DEL PAGO -->
                <!-- ========================================= -->
                <div class="col-md-3 mb-3">

                    <div class="border rounded p-3 text-center bg-light">

                        <small class="text-muted">
                            Estado
                        </small>

                        <div id="lblEstadoPago" class="mt-2">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ===================================================== -->
    <!-- 🔹 PEDIDOS -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4 d-none" id="cardPedidos">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Pedidos con saldo pendiente
            </h5>

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Pedido</th>
                            <th>Fecha</th>
                            <th>Total Venta</th>
                            <th>Saldo</th>
                            <th>Tipo</th>
                            <th>Estado Pago</th>
                            <th style="width:100px;">Ver</th>
                            <th style="width:120px;">Acción</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyPedidos"></tbody>

                </table>

            </div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 DETALLE -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-4 d-none" id="cardDetalle">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="card-title m-0">
                    Detalle Pedido
                </h5>

                <div>
                    <strong>Pedido:</strong>
                    <span id="detallePedidoId"></span>
                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-striped table-bordered">

                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Talla</th>
                            <th>Color</th>
                            <th>Docenas</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyDetalle"></tbody>

                </table>

            </div>

        </div>
    </div>

</div>



<!-- ===================================================== -->
<!-- 🔹 HISTORIAL DE ABONOS -->
<!-- ===================================================== -->

<div class="card shadow-sm mb-4 d-none"
     id="cardHistorialAbonos">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="card-title mb-0">
                Historial de Abonos
            </h5>

            <div id="lblResumenAbonos"
                 class="fw-bold text-success">
            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-light">                  

                    <tr>
                        <th style="width:160px;">RC</th>

                        <th style="width:140px; white-space:nowrap;">
                            Fecha
                        </th>

                        <th style="width:140px;">
                            Monto
                        </th>

                        <th style="width:140px;">
                            Método Pago
                        </th>

                        <th style="width:150px;">
                            Usuario
                        </th>

                        <th style="min-width:250px;">
                            Observación
                        </th>

                        <th style="width:140px;">
                            Acciones
                        </th>
                    </tr>
                </thead>

                <tbody id="tbodyHistorialAbonos">
                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- ===================================================== -->
<!-- 🔹 MODAL ABONO -->
<!-- ===================================================== -->

<div class="modal fade" id="modalAbono" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content shadow-lg border-0">

            <!-- =============================== -->
            <!-- 🔹 CABECERA -->
            <!-- =============================== -->
            <div class="modal-header bg-success text-white">

                <h5 class="modal-title fw-bold">
                    💰 Registrar Abono
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden" id="ID_Pedido" />

                <!-- =============================== -->
                <!-- 🔹 SALDO PENDIENTE -->
                <!-- =============================== -->
                <div class="card border-danger bg-light mb-4">

                    <div class="card-body text-center">

                        <small class="text-muted d-block mb-1">
                            Saldo pendiente
                        </small>

                        <input type="text"
                               id="saldoPendiente"
                               class="form-control form-control-lg text-center fw-bold text-danger border-0 bg-transparent fs-4"
                               readonly />

                    </div>

                </div>

                <!-- =============================== -->
                <!-- 🔹 MONTO -->
                <!-- =============================== -->
                <input type="number"
                       id="Monto"
                       class="form-control form-control-lg"
                       min="1"
                       placeholder="Ingrese el valor del abono" />
                

                <!-- =============================== -->
                <!-- 🔹 MÉTODO DE PAGO -->
                <!-- =============================== -->
                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        💳 Método de pago
                    </label>

                    <select id="MetodoPago"
                            class="form-select">

                        <option value="">
                            Seleccione un método de pago...
                        </option>

                    </select>

                </div>

                <!-- =============================== -->
                <!-- 🔹 OBSERVACIÓN -->
                <!-- =============================== -->
                <div class="mb-2">

                    <label class="form-label fw-semibold">
                        📝 Observación
                    </label>

                    <textarea id="Observacion"
                              class="form-control"
                              rows="3"
                              placeholder="Ingrese una observación si es necesario (opcional)">
                    </textarea>

                </div>

            </div>

            <!-- =============================== -->
            <!-- 🔹 PIE DEL MODAL -->
            <!-- =============================== -->
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cerrar

                </button>

                <button type="button"
                        class="btn btn-success px-4"
                        onclick="guardarAbono()">

                    💾 Guardar Abono

                </button>

            </div>

        </div>

    </div>

</div>
@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        let clienteSeleccionado = null;

        // =====================================================
        // 🔹 BUSCAR CLIENTE
        // =====================================================

        async function buscarCliente() {

            const term = document.getElementById("txtBuscarCliente").value;

            if (!term.trim()) {
                return;
            }

            const response = await fetch(
                `/Abonos/BuscarClientes?term=${encodeURIComponent(term)}`
            );

            const data = await response.json();

            let html = '';

            if (data.length === 0) {

                html = `
                    <div class="alert alert-warning">
                        No se encontraron clientes.
                    </div>
                `;
            }
            else {

                html += `<div class="list-group">`;

                data.forEach(c => {

                    html += `
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                onclick='seleccionarCliente(${JSON.stringify(c)})'>

                            <strong>${c.nombreCompleto}</strong>
                            <br>
                            <small>Cédula: ${c.cedula}</small>

                        </button>
                    `;
                });

                html += `</div>`;
            }

            document.getElementById("listaClientes").innerHTML = html;
        }

        // =====================================================
        // 🔹 SELECCIONAR CLIENTE
        // =====================================================

        async function seleccionarCliente(cliente) {

            clienteSeleccionado = cliente;

            document.getElementById("clienteNombre").innerText =
                cliente.nombreCompleto;

            document.getElementById("clienteCedula").innerText =
                cliente.cedula;

            document.getElementById("cardCliente")
                .classList.remove("d-none");

            document.getElementById("listaClientes").innerHTML = "";

            await cargarPedidos(cliente.id_Cliente);
        }

        // =====================================================
        // 🔹 CARGAR PEDIDOS
        // =====================================================

        async function cargarPedidos(idCliente) {

            const response = await fetch(
                `/Abonos/ObtenerPedidosPendientes?idCliente=${idCliente}`
            );

            const data = await response.json();

            const tbody = document.getElementById("tbodyPedidos");

            tbody.innerHTML = "";

            if (data.length === 0) {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted">

                            El cliente no tiene pedidos pendientes.

                        </td>
                    </tr>
                `;
            }
              else {

                  data.forEach(p => {

                  tbody.innerHTML += `
                    <tr>

                        <td>${p.id_Pedido}</td>

                        <td>${p.fecha}</td>

                        <td>
                            $ ${Number(p.totalVenta).toLocaleString()}
                        </td>

                        <td class="fw-bold text-danger">
                            $ ${Number(p.saldo).toLocaleString()}
                        </td>

                        <td>${p.tipoVenta}</td>

                        <td>${p.estadoPago}</td>

                        <td>

                            <button class="btn btn-info btn-sm"
                                    onclick="verPedido(${p.id_Pedido})">

                                Ver

                            </button>

                        </td>

                        <td>

                            <button class="btn btn-success btn-sm"
                                    onclick="abrirModalAbono(${p.id_Pedido}, ${p.saldo})">

                                Abonar

                            </button>

                        </td>

                    </tr>
                  `;
          });
             }

            document.getElementById("cardPedidos")
                .classList.remove("d-none");
        }


        // =====================================================
        // 🔹 VER PEDIDO
        // =====================================================

        async function verPedido(idPedido) {

            await cargarDetallePedido(idPedido);

            await cargarResumenPedido(idPedido);

            await cargarHistorialAbonos(idPedido);
        }

              // =====================================================
        // 🔹 MODAL
        // =====================================================

        async function abrirModalAbono(idPedido, saldo) {

            document.getElementById("ID_Pedido").value = idPedido;

               document.getElementById("saldoPendiente").value =
        "$ " + Number(saldo).toLocaleString('es-CO');

            document.getElementById("Monto").value = "";

            document.getElementById("Monto").max = saldo;

            document.getElementById("Observacion").value = "";

            await cargarMetodosPago();

            const modal = new bootstrap.Modal(
                document.getElementById('modalAbono')
            );

            modal.show();
        }
              

        // =====================================================
        // 🔹 MÉTODOS DE PAGO
        // =====================================================

        async function cargarMetodosPago() {

            const response = await fetch(
                '/Abonos/ObtenerMetodosPago'
            );

            const data = await response.json();

            const select = document.getElementById("MetodoPago");

            select.innerHTML = `
                <option value="">
                    Seleccione...
                </option>
            `;

            data.forEach(m => {

                select.innerHTML += `
                    <option value="${m.value}">
                        ${m.text}
                    </option>
                `;
            });
        }

        // =====================================================
        // 🔹 DETALLE PEDIDO
        // =====================================================

        async function cargarDetallePedido(idPedido) {

            const response = await fetch(
                `/Abonos/ObtenerDetallePedido?idPedido=${idPedido}`
            );

            const data = await response.json();

            const tbody = document.getElementById("tbodyDetalle");

            tbody.innerHTML = "";

            data.forEach(d => {

                tbody.innerHTML += `
                    <tr>

                        <td>${d.producto}</td>

                        <td>${d.talla}</td>

                        <td>${d.color}</td>

                        <td>${d.cantidad}</td>

                        <td>
                            $ ${Number(d.subtotal).toLocaleString()}
                        </td>

                    </tr>
                `;
            });

            document.getElementById("detallePedidoId").innerText =
                idPedido;

            document.getElementById("cardDetalle")
                .classList.remove("d-none");
        }


                // =====================================================
        // 🔹 RESUMEN FINANCIERO
        // =====================================================

        async function cargarResumenPedido(idPedido) {

            const response = await fetch(
                `/Abonos/ObtenerResumenPedido?idPedido=${idPedido}`
            );

            const data = await response.json();

            document.getElementById("lblTotalVenta").innerText =
                "$ " + Number(data.totalVenta).toLocaleString();

            document.getElementById("lblTotalAbonado").innerText =
                "$ " + Number(data.totalAbonado).toLocaleString();


                  let saldoHtml = '';

            if (Number(data.saldo) <= 0) {

                saldoHtml = `
                    <span class="badge bg-success fs-6">
                        $ ${Number(data.saldo).toLocaleString()}
                    </span>
                `;
            }
            else {

                saldoHtml = `
                    <span class="badge bg-danger fs-6">
                        $ ${Number(data.saldo).toLocaleString()}
                    </span>
                `;
            }

          document.getElementById("lblSaldoPendiente").innerHTML =
            saldoHtml;



            let badgeEstado = '';

            switch (data.estadoPago) {

                case 'PAGADO':

                    badgeEstado = `
                        <span class="badge bg-success fs-6">
                            PAGADO
                        </span>
                    `;
                    break;

                case 'ABONADO':

                    badgeEstado = `
                        <span class="badge bg-warning text-dark fs-6">
                            ABONADO
                        </span>
                    `;
                    break;

                default:

                    badgeEstado = `
                        <span class="badge bg-danger fs-6">
                            PENDIENTE
                        </span>
                    `;
                    break;
            }

            document.getElementById("lblEstadoPago").innerHTML =
                badgeEstado;

            document.getElementById("cardResumenFinanciero")
                .classList.remove("d-none");
        }

        // =====================================================
        // 🔹 HISTORIAL ABONOS
        // =====================================================

        async function cargarHistorialAbonos(idPedido) {

            const response = await fetch(
                `/Abonos/ObtenerHistorialAbonos?idPedido=${idPedido}`
            );

            const data = await response.json();

            const tbody =
                document.getElementById("tbodyHistorialAbonos");

            tbody.innerHTML = "";

            if (data.length === 0) {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted">

                            No existen abonos registrados.

                        </td>
                    </tr>
                `;
            }
            else {

                data.forEach(x => {

                    tbody.innerHTML += `
                        <tr>

                            <td>
                                <span class="badge bg-success">
                                    ${x.numeroRecibo}
                                </span>
                            </td>


                            <td style="white-space: nowrap;">
                                ${x.fecha}
                            </td>
                            
                            <td class="fw-bold text-success">
                                $ ${Number(x.monto).toLocaleString()}
                            </td>

                            <td>${x.metodoPago}</td>

                             <td>
                                <span class="badge bg-info text-dark">
                                    ${x.usuario ?? ''}
                                </span>
                            </td>                           

                            <td>${x.observacion ?? ''}</td>

                            <td>

                                <button
                                    class="btn btn-sm btn-primary"
                                    onclick="window.open('${x.urlPdf}','_blank')">

                                    PDF

                                </button>

                                <button
                                    class="btn btn-sm btn-secondary"
                                    onclick="imprimirPDF('${x.urlPdf}')">

                                    Imprimir

                                </button>

                            </td>

                        </tr>
                    `;
                });
            }

               const totalAbonado = data.reduce(
                (total, item) => total + Number(item.monto),
                    0
               );

              document.getElementById("lblResumenAbonos").innerHTML =
                `
                <span class="badge bg-primary">
                    ${data.length} Abonos
                </span>

                <span class="badge bg-success">
                    $ ${totalAbonado.toLocaleString('es-CO')}
                </span>
             `;

                     document.getElementById("lblResumenAbonos").innerHTML =
        `
                    <span class="badge bg-primary">
                        ${data.length} Abonos
                    </span>

                    <span class="badge bg-success">
                        $ ${totalAbonado.toLocaleString('es-CO')}
                    </span>
                `;

            // Mostrar tarjeta
            document.getElementById("cardHistorialAbonos")
                .classList.remove("d-none");
        }

        // ================FUNCIÓN IMPRIMIR=====================================

                function imprimirPDF(url) {

            const ventana = window.open(url, "_blank");

            ventana.onload = function () {
                ventana.print();
            };
        }

        // =====================================================
        // 🔹 GUARDAR ABONO
        // =====================================================

        async function guardarAbono() {

            const saldo = parseFloat(
                document.getElementById("saldoPendiente").value
            );

            const data = {

                ID_Pedido: parseInt(
                    document.getElementById("ID_Pedido").value
                ),

               Monto: parseFloat(
                  document.getElementById("Monto").value
                .replace(/\$/g, "")
                .replace(/\./g, "")
                .replace(/\s/g, "")
               ),

                ID_MetodoPago: parseInt(
                    document.getElementById("MetodoPago").value
                ),

                Observacion: document.getElementById("Observacion").value
            };

            // ==========================================
            // 🔥 VALIDACIONES
            // ==========================================

            if (!data.Monto || data.Monto <= 0) {

                alert("Ingrese un monto válido.");
                return;
            }

            if (data.Monto > saldo) {

                alert("El monto no puede superar el saldo.");
                return;
            }

            if (!data.ID_MetodoPago) {

                alert("Seleccione un método de pago.");
                return;
            }


        // ==========================================
        // 🔥 ENVIAR
        // ==========================================

        try {

            const response = await fetch('/Abonos/RegistrarAbono', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(data)
            });

            if (!response.ok) {

                const error = await response.text();

                alert(error);

                return;
            }

            const result = await response.json();

            console.log(result);

            if (result.urlPdf) {

                window.open(result.urlPdf, '_blank');
            }

        }
        catch (error) {

            console.error(error);

            alert("Ocurrió un error al registrar el abono.");
        }
            /*
            // ==========================================
            // 🔥 ENVIAR
            // ==========================================
                       
            const response = await fetch('/Abonos/RegistrarAbono', {
                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(data)
            });

            if (!response.ok) {

                const error = await response.text();

                alert(error);

                return;
            }

            const result = await response.json();

            alert(result.mensaje);
            */
            // ==========================================
            // 🔥 CERRAR MODAL
            // ==========================================

            bootstrap.Modal.getInstance(
                document.getElementById('modalAbono')
            ).hide();

            // ==========================================
            // 🔥 RECARGAR PEDIDOS
            // ==========================================

            const idPedido =
             parseInt(document.getElementById("ID_Pedido").value);

             await cargarPedidos(clienteSeleccionado.id_Cliente);

             await verPedido(idPedido);

        }

    </script>
}