@model InventarioWEB.ViewModels.VentaDetalleVM

@{
    ViewData["Title"] = "Detalle de Venta";
}

<div class="container mt-3">

    <!-- ===================================================== -->
    <!-- HEADER VENTA -->
    <!-- ===================================================== -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">DETALLE DE LA VENTA #@Model.ID_Pedido</h4>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-4">
                    <strong>Cliente:</strong><br />
                    @Model.Cliente
                </div>

                <div class="col-md-4">
                    <strong>Fecha:</strong><br />
                    @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="col-md-4">
                    <strong>Tipo de Venta:</strong><br />
                    @Model.TipoVenta
                </div>

                <div class="col-md-4 mt-2">
                    <strong>Estado Pedido:</strong><br />
                    @Model.EstadoPedido
                </div>

                <div class="col-md-4 mt-2">
                    <strong>Estado Pago:</strong><br />
                    @Model.EstadoPago
                </div>

                <div class="col-md-4 mt-2">
                    <strong>Estado Despacho:</strong><br />
                    @Model.EstadoDespacho
                </div>

            </div>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- RESUMEN FINANCIERO -->
    <!-- ===================================================== -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">RESUMEN FINANCIERO</h5>
        </div>

        <div class="card-body row">

            <div class="col-md-3">
                <strong>Total Venta:</strong><br />
                $@Model.TotalVenta.ToString("N0")
            </div>

            <div class="col-md-3">
                <strong>Total Abonado:</strong><br />
                $@Model.TotalAbonado.ToString("N0")
            </div>

            <div class="col-md-3">
                <strong>Saldo:</strong><br />
                $@Model.Saldo.ToString("N0")
            </div>

            <div class="col-md-3">
                <strong>Estado:</strong><br />
                <span class="badge bg-@(Model.Estado == "Pagado" ? "success" : "warning")">
                    @Model.Estado
                </span>
            </div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- ABONOS -->
    <!-- ===================================================== -->
    <div class="card shadow-sm mb-3">

        <div class="card-header bg-info text-white">
            <h5 class="mb-0">HISTORIAL DE PAGOS</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.Abonos != null && Model.Abonos.Any())
            {
                <table class="table table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Método</th>
                            <th>Recibo</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var abono in Model.Abonos)
                        {
                            <tr>
                                <td>@abono.Fecha_Abono.ToString("dd/MM/yyyy")</td>
                                <td>@abono.MetodoPago</td>
                                <td>@abono.NumeroRecibo</td>
                                <td class="text-end">$@abono.Monto.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-3 text-center text-muted">
                    No registra abonos
                </div>
            }

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- PRODUCTOS -->
    <!-- ===================================================== -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">PRODUCTOS VENDIDOS</h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-bordered table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th>Talla</th>
                        <th>Color</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Productos)
                    {
                        <tr>
                            <td>@item.Producto</td>
                            <td>@item.Talla</td>
                            <td>@item.Color</td>
                            <td class="text-center">@item.Cantidad</td>
                            <td class="text-end">$@item.PrecioVenta.ToString("N0")</td>
                            <td class="text-end">$@item.Subtotal.ToString("N0")</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- ACCIONES -->
    <!-- ===================================================== -->
    <div class="mt-3 d-flex gap-2">

        <a asp-action="Index" class="btn btn-secondary">
            ← Volver
        </a>

        <a asp-action="Reporte"
           asp-route-id="@Model.ID_Pedido"
           class="btn btn-danger">
            📄 Generar Reporte
        </a>

    </div>

</div>