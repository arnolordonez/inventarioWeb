@model InventarioWEB.ViewModels.VentaDetalleVM

@{
    ViewData["Title"] = "Detalle de Venta";
}

<div class="container mt-3">

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Info"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- ===================================================== -->
    <!-- HEADER VENTA -->
    <!-- ===================================================== -->
    <div class="card shadow-sm mb-3">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                DETALLE DE LA VENTA #@Model.ID_Pedido
            </h4>
        </div>

        <div class="card-body">

            <!-- ============================================= -->
            <!-- INFORMACIÓN GENERAL -->
            <!-- ============================================= -->
            <div class="row">

                <div class="col-md-4 mb-3">
                    <strong>Cliente:</strong><br />
                    @Model.Cliente
                </div>

                <div class="col-md-4 mb-3">
                    <strong>Fecha:</strong><br />
                    @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="col-md-4 mb-3">
                    <strong>Tipo de Venta:</strong><br />
                    @Model.TipoVenta
                </div>

            </div>

            <!-- ============================================= -->
            <!-- ESTADO DEL PROCESO COMERCIAL -->
            <!-- ============================================= -->
            <div class="row">

                <div class="col-md-4">
                    <strong>Estado del Pedido:</strong><br />
                    @Model.EstadoPedido
                </div>

                <div class="col-md-4">
                    <strong>Estado del Pago:</strong><br />
                    @Model.EstadoPago
                </div>

                <div class="col-md-4">
                    <strong>Estado del Despacho:</strong><br />
                    @Model.EstadoDespacho
                </div>

            </div>

            <!-- ============================================= -->
            <!-- INFORMACIÓN DEL DESPACHO -->
            <!-- ============================================= -->
            <div class="row mt-3">

                <div class="col-md-4">
                    <strong>Tipo de Despacho:</strong><br />
                    @Model.TipoDespacho
                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- RESUMEN FINANCIERO -->
    <!-- ===================================================== -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">RESUMEN FINANCIERO</h5>
        </div>

        <div class="card-body row">

            <div class="col-md-3">
                <strong>Total Venta:</strong><br />
                $@Model.TotalVenta.ToString("N0")
            </div>

            <div class="col-md-3">
                <strong>Total Abonado:</strong><br />
                $@Model.TotalAbonado.ToString("N0")
            </div>

            <div class="col-md-3">
                <strong>Saldo:</strong><br />
                $@Model.Saldo.ToString("N0")
            </div>

            <div class="col-md-3">
                <strong>Estado:</strong><br />
                <span class="badge bg-@(Model.Estado == "Pagado" ? "success" : "warning")">
                    @Model.Estado
                </span>
            </div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- ABONOS -->
    <!-- ===================================================== -->
    <div class="card shadow-sm mb-3">

        <div class="card-header bg-info text-white">
            <h5 class="mb-0">HISTORIAL DE PAGOS</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.Abonos != null && Model.Abonos.Any())
            {
                <table class="table table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Método</th>
                            <th>Recibo</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var abono in Model.Abonos)
                        {
                            <tr>
                                <td>@abono.Fecha_Abono.ToString("dd/MM/yyyy")</td>
                                <td>@abono.MetodoPago</td>
                                <td>@abono.NumeroRecibo</td>
                                <td class="text-end">$@abono.Monto.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-3 text-center text-muted">
                    No registra abonos
                </div>
            }

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- PRODUCTOS -->
    <!-- ===================================================== -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">PRODUCTOS VENDIDOS</h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-bordered table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th>Talla</th>
                        <th>Color</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Productos)
                    {
                        <tr>
                            <td>@item.Producto</td>
                            <td>@item.Talla</td>
                            <td>@item.Color</td>
                            <td class="text-center">@item.Cantidad</td>
                            <td class="text-end">$@item.PrecioVenta.ToString("N0")</td>
                            <td class="text-end">$@item.Subtotal.ToString("N0")</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>
        
   
    <!-- ===================================================== -->
    <!-- ACCIONES DEL DOCUMENTO -->
    <!-- ===================================================== -->
    <div class="card shadow-sm mt-4">

        <div class="card-header bg-light">
            <h5 class="mb-0">
                ACCIONES DEL DOCUMENTO
            </h5>
        </div>

        <div class="card-body">

            <div class="d-flex flex-wrap gap-2">

                <!-- Volver -->
                <a asp-action="Index"
                   class="btn btn-secondary">
                    ← Volver
                </a>

                <!-- Imprimir -->
                <a asp-action="ImprimirVenta"
                   asp-route-id="@Model.ID_Pedido"
                   target="_blank"
                   class="btn btn-primary">
                    🖨 Imprimir
                </a>
                                
                <!-- Descargar PDF -->
                <a asp-action="ExportarPdfVenta"
                   asp-route-id="@Model.ID_Pedido"
                   target="_blank"
                   class="btn btn-danger">
                    📄 Descargar PDF
                </a>
                                
                <!-- Enviar por correo -->
                <a asp-action="EnviarCorreoVenta"
                   asp-route-id="@Model.ID_Pedido"
                   class="btn btn-success">

                    📧 Enviar por correo
                </a>
            </div>

            <hr />

            <small class="text-muted">
                Utilice estas opciones para imprimir la venta, generar un documento PDF o enviarlo por correo electrónico.
            </small>

        </div>

    </div>
</div>