@model InventarioWEB.ViewModels.VentaDetalleVM

@{
    Layout = null; // IMPORTANTE para PDF
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte Venta</title>

    <style>
        body { font-family: Arial; font-size: 12px; }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .box {
            border: 1px solid #000;
            padding: 10px;
            margin-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            border: 1px solid #000;
            padding: 6px;
        }

        th {
            background: #eee;
        }

        .right {
            text-align: right;
        }
    </style>
</head>

<body>

    <div class="header">
        <h2>REPORTE DE VENTA</h2>
        <h4>Pedido #@Model.ID_Pedido</h4>
    </div>

    <!-- INFO GENERAL -->
    <div class="box">
        <strong>Cliente:</strong> @Model.Cliente <br />
        <strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy") <br />
        <strong>Tipo Venta:</strong> @Model.TipoVenta <br />
        <strong>Estado:</strong> @Model.Estado
    </div>

    <!-- FINANCIERO -->
    <div class="box">
        <strong>Total Venta:</strong> @Model.TotalVenta.ToString("N0") <br />
        <strong>Total Abonado:</strong> @Model.TotalAbonado.ToString("N0") <br />
        <strong>Saldo:</strong> @Model.Saldo.ToString("N0")
    </div>

    <!-- PRODUCTOS -->
    <table>
        <thead>
            <tr>
                <th>Producto</th>
                <th>Talla</th>
                <th>Color</th>
                <th>Cantidad</th>
                <th class="right">Precio</th>
                <th class="right">Subtotal</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Model.Productos)
            {
                <tr>
                    <td>@p.Producto</td>
                    <td>@p.Talla</td>
                    <td>@p.Color</td>
                    <td>@p.Cantidad</td>
                    <td class="right">@p.PrecioVenta.ToString("N0")</td>
                    <td class="right">@p.Subtotal.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>

    <br />

    <div class="box">
        <strong>Estado del pedido:</strong> @Model.EstadoPedido <br />
        <strong>Estado del pago:</strong> @Model.EstadoPago <br />
        <strong>Estado del despacho:</strong> @Model.EstadoDespacho
    </div>

</body>
</html>