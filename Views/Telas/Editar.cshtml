@model InventarioWEB.ViewModels.Catalogos.Telas.TelaEditVM

@{
    ViewData["Title"] = "Editar Tela";
}

<h3 class="mb-3">Editar Tela</h3>

<form asp-action="Editar" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ID_Telas" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="DescripTela" class="form-label"></label>
        <input asp-for="DescripTela" class="form-control" />
        <span asp-validation-for="DescripTela" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">
        <i class="bi bi-pencil-square"></i> Actualizar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
