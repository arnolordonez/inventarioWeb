@model InventarioWEB.ViewModels.Catalogos.Telas.TelasIndexVM

@{
    ViewData["Title"] = "Telas";
}

<h3 class="mb-3">Catálogo de Telas</h3>

<a asp-action="Crear" class="btn btn-primary mb-3">
    <i class="bi bi-plus-circle"></i> Nueva Tela
</a>

<!-- ================================
     TELAS ACTIVAS
================================ -->
<h5 class="mt-4">Telas Activas</h5>

@if (Model.Telas != null && Model.Telas.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Descripción</th>
                <th style="width:200px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Telas)
            {
                <tr>
                    <td>@item.ID_Telas</td>
                    <td>@item.DescripTela</td>
                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@item.ID_Telas"
                           class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>

                        <!-- Eliminación lógica -->
                        <form asp-action="Eliminar"
                              asp-route-id="@item.ID_Telas"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('¿Seguro que deseas eliminar esta tela?');">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No hay telas activas.
    </div>
}

<!-- ================================
     TELAS ELIMINADAS (LÓGICAS)
================================ -->
@if (Model.TelasEliminadas != null && Model.TelasEliminadas.Any())
{
    <h5 class="mt-5 text-danger">Telas Eliminadas</h5>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Descripción</th>
                <th style="width:170px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.TelasEliminadas)
            {
                <tr class="table-danger">
                    <td>@item.ID_Telas</td>
                    <td>@item.DescripTela</td>
                    <td>
                        <form asp-action="Restaurar"
                              asp-route-id="@item.ID_Telas"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-success"
                                    onclick="return confirm('¿Deseas restaurar esta tela?');">
                                <i class="bi bi-arrow-clockwise"></i> Restaurar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
