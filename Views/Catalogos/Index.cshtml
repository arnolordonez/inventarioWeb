@{
    ViewData["Title"] = "Catálogos";
    Layout = "_Layout";
}

<div class="mt-4">

    <!-- ============================
         TÍTULO
    ============================ -->
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="fw-bold text-primary">
                <i class="bi bi-collection me-2"></i>
                Gestión de Catálogos
            </h3>

            <p class="text-muted">
                Administra las tablas base que definen los productos del sistema
                (géneros, referencias, tallas, telas y colores).
            </p>
        </div>
    </div>

    <hr />

    <!-- ============================
         TARJETAS
    ============================ -->
    <div class="row g-4">

        <!-- GÉNEROS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <i class="bi bi-gender-ambiguous fs-1 text-primary"></i>
                    <h5 class="mt-3 fw-semibold">Géneros</h5>
                    <p class="text-muted small">
                        Hombre, Mujer, Niño, etc.
                    </p>
                    <a asp-controller="Generos"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-sm">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <!-- REFERENCIAS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <i class="bi bi-tag fs-1 text-success"></i>
                    <h5 class="mt-3 fw-semibold">Referencias</h5>
                    <p class="text-muted small">
                        Boxer, Camiseta, Pantalón, etc.
                    </p>
                    <a asp-controller="Referencias"
                       asp-action="Index"
                       class="btn btn-outline-success btn-sm">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <!-- TALLAS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <i class="bi bi-arrows-angle-expand fs-1 text-warning"></i>
                    <h5 class="mt-3 fw-semibold">Tallas</h5>
                    <p class="text-muted small">
                        S, M, L, XL, 3XL, etc.
                    </p>
                    <a asp-controller="Tallas"
                       asp-action="Index"
                       class="btn btn-outline-warning btn-sm">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <!-- TELAS -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <i class="bi bi-layers fs-1 text-info"></i>
                    <h5 class="mt-3 fw-semibold">Telas</h5>
                    <p class="text-muted small">
                        Algodón, Lycra, Poliéster, etc.
                    </p>
                    <a asp-controller="Telas"
                       asp-action="Index"
                       class="btn btn-outline-info btn-sm">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

        <!-- COLORES -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <i class="bi bi-palette fs-1 text-danger"></i>
                    <h5 class="mt-3 fw-semibold">Colores</h5>
                    <p class="text-muted small">
                        Negro, Blanco, Azul, etc.
                    </p>
                    <a asp-controller="Colores"
                       asp-action="Index"
                       class="btn btn-outline-danger btn-sm">
                        Administrar
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>
