@model InventarioWEB.ViewModels.Catalogos.Colores.ColorCreateVM

@{
    ViewData["Title"] = "Nuevo Color";
    Layout = "_Layout";
}

<div class="mt-4">

    <h3 class="fw-bold text-danger">
        <i class="bi bi-plus-circle me-2"></i> Nuevo Color
    </h3>
    <p class="text-muted">
        Ingrese el nombre del color.
    </p>

    <hr />

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-semibold"></label>
                    <input asp-for="Nombre"
                           class="form-control"
                           autocomplete="off"
                           maxlength="100" />
                    <span asp-validation-for="Nombre"
                          class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-save me-1"></i> Guardar
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
