@model InventarioWEB.Models.Cliente

@{
    ViewData["Title"] = "Detalle de cliente";
}

<h4>Detalle de cliente</h4>

@if (Model == null)
{
    <div class="alert alert-warning">
        Cliente no encontrado.
    </div>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
}
else
{
    <div class="card p-3 shadow-sm">
        <dl class="row">
            <dt class="col-sm-3">Cédula</dt>
            <dd class="col-sm-9">@Model.ID_Cliente</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Apellido</dt>
            <dd class="col-sm-9">@Model.Apellido</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.Correo</dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Telefono</dd>

            <dt class="col-sm-3">Tipo de cliente</dt>
            <dd class="col-sm-9">@Model.TipoCliente</dd>

            <dt class="col-sm-3">VIP</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.VIP ? "bg-warning text-dark" : "bg-secondary")">
                    @(Model.VIP ? "SI" : "NO")
                </span>
            </dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">
                    @(Model.Activo ? "Activo" : "Inactivo")
                </span>
            </dd>

            <dt class="col-sm-3">Fecha registro</dt>
            <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Observaciones</dt>
            <dd class="col-sm-9">
                @(!string.IsNullOrWhiteSpace(Model.Observaciones) ? Model.Observaciones : "Sin observaciones")
            </dd>
        </dl>

        <div class="mt-3 d-flex gap-2">
            @if (Model.Activo)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.ID_Cliente"
                   class="btn btn-primary">
                    Editar
                </a>

                <form asp-action="Delete" method="post" class="d-inline"
                      onsubmit="return confirm('¿Está seguro de desactivar este cliente?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ID_Cliente" />
                    <button type="submit" class="btn btn-danger">
                        Desactivar
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Restore" method="post" class="d-inline"
                      onsubmit="return confirm('¿Está seguro de restaurar este cliente?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ID_Cliente" />
                    <button type="submit" class="btn btn-success">
                        Restaurar
                    </button>
                </form>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">
                Volver
            </a>
        </div>
    </div>
}
