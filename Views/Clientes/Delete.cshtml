@model InventarioWEB.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container mt-4">

    <h4 class="text-danger fw-bold mb-3">
        @if (Model.Activo)
        {
            @:¿Estás seguro de desactivar este cliente?
        }
        else
        {
            @:Cliente inactivo
        }
    </h4>

    @if (Model.Activo)
    {
        <div class="alert alert-warning">
            ⚠️ Esta acción <strong>no elimina el cliente definitivamente</strong>.
            El cliente quedará inactivo y podrá ser restaurado posteriormente.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            ℹ️ Este cliente ya se encuentra inactivo. Puedes restaurarlo si lo deseas.
        </div>
    }

    <div class="card shadow-sm p-3">

        <h5 class="fw-bold">@Model.Nombre @Model.Apellido</h5>

        <p><strong>Cédula:</strong> @Model.ID_Cliente</p>
        <p><strong>Correo:</strong> @Model.Correo</p>
        <p><strong>Teléfono:</strong> @Model.Telefono</p>

        <p>
            @if (Model.VIP)
            {
                <span class="badge bg-warning text-dark">Cliente VIP</span>
            }
            else
            {
                <span class="badge bg-secondary">Cliente Normal</span>
            }
        </p>

        <hr />

        <div class="d-flex gap-2">
            @if (Model.Activo)
            {
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ID_Cliente" />

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirmar desactivación
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Restore" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ID_Cliente" />

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-arrow-counterclockwise"></i> Restaurar cliente
                    </button>
                </form>
            }

            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                Cancelar
            </a>
        </div>
    </div>
</div>
