@model InventarioWEB.ViewModels.ProduccionCrearViewModel
@{
    ViewData["Title"] = "Producción / Inventario";
}
<form id="formProduccion" method="post" action="/Produccion/Crear">
    @Html.AntiForgeryToken()

    <div class="container-fluid">

        <div class="row mb-3">
            <div class="col-12">
                <h3 class="fw-bold text-primary mb-1">🏭 Producción / Inventario</h3>
                <p class="text-muted mb-0">
                    Registro de producción e incremento de stock.
                </p>
            </div>
        </div>

        <!-- FILTROS -->
        <div class="card shadow-sm mb-3">

            <div class="card-header bg-light fw-bold">
                🔍 Filtros de búsqueda
            </div>

            <div class="card-body">

                <div class="row g-2">

                    <div class="col-md-2">
                        <label class="form-label">Código</label>
                        <input type="number"
                               class="form-control"
                               name="idProducto"
                               min="1" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Género</label>
                        <select class="form-select"
                                id="filtroGenero"
                                name="idGenero">
                            <option value="">-- Seleccione --</option>
                            @foreach (var g in ViewBag.Generos as SelectList)
                            {
                                <option value="@g.Value">@g.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Referencia</label>
                        <select class="form-select"
                                id="filtroReferencia"
                                name="idReferencia">
                            <option value="">-- Todas --</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Talla</label>
                        <select class="form-select"
                                id="filtroTalla"
                                name="idTalla">
                            <option value="">-- Todas --</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Tela</label>
                        <select class="form-select"
                                id="filtroTela"
                                name="idTela">
                            <option value="">-- Todas --</option>
                            @foreach (var t in ViewBag.Telas as SelectList)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Color</label>
                        <select class="form-select"
                                id="filtroColor"
                                name="idColor">
                            <option value="">-- Todos --</option>
                            @foreach (var c in ViewBag.Colores as SelectList)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="row mt-3">
                    <div class="col-md-3">
                        <button type="button"
                                id="btnBuscarProduccion"
                                class="btn btn-primary w-100">
                            🔎 Buscar
                        </button>
                    </div>
                </div>

            </div>

        </div>

        <!-- RESULTADOS -->
        <div class="card shadow-sm">

            <div class="card-header bg-light fw-bold">
                📦 Productos encontrados
            </div>

            <div class="card-body">

                <div id="contenedorResultadosProduccion"
                     class="table-responsive text-muted">
                    Realiza una búsqueda para visualizar productos.
                </div>

            </div>

        </div>

        <!-- BOTÓN REGISTRAR -->
        <div class="row mt-3">

            <div class="col-md-3">

                <button type="submit"
                        class="btn btn-success w-100">
                    💾 Registrar Producción
                </button>

            </div>

        </div>

    </div>

</form>
@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded",function(){

            const filtroGenero = document.getElementById("filtroGenero");
            const filtroReferencia = document.getElementById("filtroReferencia");
            const filtroTalla = document.getElementById("filtroTalla");
            const btnBuscar = document.getElementById("btnBuscarProduccion");
            const contenedor = document.getElementById("contenedorResultadosProduccion");
            const form = document.getElementById("formProduccion");


            filtroReferencia.disabled = true;
            filtroTalla.disabled = true;

            filtroGenero.addEventListener("change",async function(){

                const idGenero = this.value;

                filtroReferencia.innerHTML = `<option value="">-- Todas --</option>`;
                filtroTalla.innerHTML = `<option value="">-- Todas --</option>`;

                filtroReferencia.disabled = true;
                filtroTalla.disabled = true;

                if(!idGenero) return;

                 try{

                        const resRef = await fetch(`/Produccion/ObtenerReferenciasPorGenero?idGenero=${idGenero}`);
                        const referencias = await resRef.json();

                        referencias.forEach(r=>{
                        const opt = document.createElement("option");
                        opt.value = r.id;
                        opt.textContent = r.descripcion;
                        filtroReferencia.appendChild(opt);
                        });

                        if(referencias.length>0) filtroReferencia.disabled=false;

                        const resTall = await fetch(`/Produccion/ObtenerTallasPorGenero?idGenero=${idGenero}`);
                        const tallas = await resTall.json();

                        tallas.forEach(t=>{
                        const opt = document.createElement("option");
                        opt.value = t.id;
                        opt.textContent = t.descripcion;
                        filtroTalla.appendChild(opt);
                        });

                        if(tallas.length>0) filtroTalla.disabled=false;

                 }
                     catch(error){
                        console.error(error);
                        contenedor.innerHTML = `<div class="text-danger">Error cargando filtros</div>`;
                     }

            });
            btnBuscar.addEventListener("click",async function(){

                    const formData = new FormData(form);
                    const params = new URLSearchParams();

                    for(let [key,value] of formData.entries()){
                  if(value) params.append(key,value);
                   }

                    if(!params.toString()){
                    contenedor.innerHTML = `<div class="text-muted">Seleccione al menos un criterio.</div>`;
                    return;
                    }

                    contenedor.innerHTML = `Consultando productos...`;

                try{

                    const r = await fetch(`/Produccion/BuscarProductos?${params.toString()}`);
                    const data = await r.json();

                    if(!data.length){
                    contenedor.innerHTML = `No se encontraron productos`;
                    return;
                    }

                    indexDetalle = 0;

                    contenedor.innerHTML = `

                        <table class="table table-sm table-hover table-bordered align-middle">

                        <thead class="table-light">

                        <tr>

                        <th style="width:80px">Código</th>
                        <th style="width:180px">Tela</th>
                        <th style="width:140px">Color</th>
                        <th style="width:140px">Género</th>
                        <th style="width:240px">Referencia</th>
                        <th style="width:90px">Talla</th>

                        <th style="width:80px" class="text-center">Stock</th>
                        <th style="width:70px" class="text-center">IVA</th>

                        <th style="width:95px" class="text-end">Costo</th>
                        <th style="width:100px" class="text-end">Precio</th>

                        <th style="width:70px" class="text-center">Cantidad</th>

                        <th style="width:110px" class="text-end">Subtotal</th>
                       

                        </tr>

                        </thead>

                        <tbody>

                       ${data.map((p,i)=>`

                        <tr>

                        <td>${p.idProducto}</td>

                        <td>${p.tela ?? ''}</td>

                        <td>${p.color ?? ''}</td>

                        <td>${p.genero ?? ''}</td>

                        <td>${p.referencia ?? ''}</td>

                        <td>${p.talla ?? ''}</td>

                        <td class="text-center stock">
                            ${p.stock ?? 0}
                            <input type="hidden" class="stock-original" value="${p.stock ?? 0}" />
                        </td>

                        <td class="text-center">
                        ${p.iva ?? 0}

                        <input type="hidden"
                        name="Detalles[${i}].IVA"
                        value="${p.iva ?? 0}" />
                        </td>

                        <td style="width:95px">

                        <input type="number"
                        class="form-control form-control-sm costo text-end"
                        style="width:85px"
                        name="Detalles[${i}].CostoUnitario"
                        value="${(p.precioCosto ?? 0).toFixed(2)}"
                        step="0.01"
                        min="0"
                        lang="en"
                        inputmode="decimal"
                        oninput="calcularSubtotal(this)" />

                        <input type="hidden"
                        name="Detalles[${i}].ID_Producto"
                        value="${p.idProducto}" />

                        </td>

                        <td class="text-end">

                        ${Number(p.precioVTA ?? 0).toFixed(2)}

                        <input type="hidden"
                        name="Detalles[${i}].PrecioVentaUnitario"
                        value="${Number(p.precioVTA ?? 0).toFixed(2)}" />

                        </td>

                        <td>

                        <input type="number"
                        class="form-control form-control-sm cantidad text-end"
                        style="width:60px;padding:2px"
                        name="Detalles[${i}].Cantidad"
                        value="0"
                        min="0"
                        oninput="calcularSubtotal(this)" />

                        </td>

                        <td class="text-end subtotal">0.00</td>

                        
                        </tr>

                       `).join("")}

                        </tbody>
                        </table>
                    `;

                }
                  catch(error){
                    console.error(error);
                    contenedor.innerHTML = `<div class="text-danger">Error consultando datos</div>`;
                  }

            });

        });

               function calcularSubtotal(input){

            const fila = input.closest("tr");

            const costo = parseFloat(
                fila.querySelector(".costo").value
            ) || 0;

            const cantidad = parseFloat(
                fila.querySelector(".cantidad").value
            ) || 0;

            // 🔥 SUBTOTAL
            const subtotal = Math.round((costo * cantidad) * 100) / 100;
            fila.querySelector(".subtotal").innerText = subtotal.toFixed(2);

            // 🔥 STOCK DINÁMICO
            const stockOriginal = parseFloat(
                fila.querySelector(".stock-original").value
            ) || 0;

            const nuevoStock = stockOriginal + cantidad;

            fila.querySelector(".stock").childNodes[0].nodeValue = nuevoStock;
        }

        function actualizarFila(btn){

            const fila = btn.closest("tr");

            const cantidad = parseFloat(
            fila.querySelector(".cantidad").value
            ) || 0;

            if(cantidad <= 0){

            alert("Debe ingresar una cantidad mayor a cero");

            return;

            }

            fila.classList.add("table-success");

            btn.innerText = "Listo";
            btn.classList.remove("btn-primary");
            btn.classList.add("btn-success");

        }

    </script>

}
