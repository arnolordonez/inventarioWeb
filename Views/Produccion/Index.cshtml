@model InventarioWEB.ViewModels.ProduccionViewModel

@{
    ViewData["Title"] = "Producción / Inventario";
}

<form id="formAntiForgery">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid">

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="fw-bold text-primary mb-1">🏭 Producción / Inventario</h3>
            <p class="text-muted mb-0">
                Selección de productos para registro de producción.
            </p>
        </div>
    </div>

    <!-- ============================= -->
    <!-- FILTROS -->
    <!-- ============================= -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light fw-bold">
            🔍 Filtros de búsqueda
        </div>

        <div class="card-body">
            <form id="formBusquedaProduccion">
                <div class="row g-2">

                    <!-- CÓDIGO -->
                    <div class="col-md-2">
                        <label class="form-label">Código</label>
                        <input type="number"
                               class="form-control"
                               name="idProducto"
                               min="1" />
                    </div>

                    <!-- GÉNERO -->
                    <div class="col-md-2">
                        <label class="form-label">Género</label>
                        <select class="form-select"
                                id="filtroGenero"
                                name="idGenero">
                            <option value="">-- Seleccione --</option>
                            @foreach (var g in ViewBag.Generos as SelectList)
                            {
                                <option value="@g.Value">@g.Text</option>
                            }
                        </select>
                    </div>

                    <!-- REFERENCIA -->
                    <div class="col-md-2">
                        <label class="form-label">Referencia</label>
                        <select class="form-select"
                                id="filtroReferencia"
                                name="idReferencia">
                            <option value="">-- Todas --</option>
                        </select>
                    </div>

                    <!-- TALLA -->
                    <div class="col-md-2">
                        <label class="form-label">Talla</label>
                        <select class="form-select"
                                id="filtroTalla"
                                name="idTalla">
                        <option value="">-- Todas --</option>
                        </select>
                    </div>

                    <!-- TELA -->
                    <div class="col-md-2">
                        <label class="form-label">Tela</label>
                        <select class="form-select"
                                id="filtroTela"
                                name="idTela">
                            <option value="">-- Todas --</option>
                            @foreach (var t in ViewBag.Telas as SelectList)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        </select>
                    </div>

                    <!-- COLOR -->
                    <div class="col-md-2">
                        <label class="form-label">Color</label>
                        <select class="form-select"
                                id="filtroColor"
                                name="idColor">
                            <option value="">-- Todos --</option>
                            @foreach (var c in ViewBag.Colores as SelectList)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- BOTÓN -->
                <div class="row mt-3">
                    <div class="col-md-3">
                        <button type="button"
                                id="btnBuscarProduccion"
                                class="btn btn-primary w-100">
                            🔎 Buscar
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>

    <!-- ============================= -->
    <!-- RESULTADOS -->
    <!-- ============================= -->
    <div class="card shadow-sm">
        <div class="card-header bg-light fw-bold">
            📦 Productos encontrados
        </div>

        <div class="card-body">
            <div id="contenedorResultadosProduccion"
                 class="table-responsive text-muted">
                Realiza una búsqueda para visualizar productos.
            </div>
        </div>
    </div>

</div>

@section Scripts {

<script>
document.addEventListener("DOMContentLoaded", function () {

    const filtroGenero = document.getElementById("filtroGenero");
    const filtroReferencia = document.getElementById("filtroReferencia");
    const filtroTalla = document.getElementById("filtroTalla");
    const btnBuscar = document.getElementById("btnBuscarProduccion");
    const contenedor = document.getElementById("contenedorResultadosProduccion");
    const form = document.getElementById("formBusquedaProduccion");

    console.log("Index Producción cargado");

    // Estado inicial
    filtroReferencia.disabled = true;
    filtroTalla.disabled = true;

    // =============================
    // CARGA DINÁMICA REFERENCIAS Y TALLAS
    // =============================
    filtroGenero.addEventListener("change", async function () {

        const idGenero = this.value;

        // Reset combos
        filtroReferencia.innerHTML = `<option value="">-- Todas --</option>`;
        filtroTalla.innerHTML = `<option value="">-- Todas --</option>`;

        filtroReferencia.disabled = true;
        filtroTalla.disabled = true;

        if (!idGenero) return;

        try {

            // REFERENCIAS
            const resRef = await fetch(`/Produccion/ObtenerReferenciasPorGenero?idGenero=${idGenero}`);

            if (!resRef.ok)
                throw new Error("Error cargando referencias");

            const referencias = await resRef.json();
            console.log("Referencias recibidas:", referencias);

            referencias.forEach(r => {
                const opt = document.createElement("option");
                opt.value = r.id;
                opt.textContent = r.descripcion;
                filtroReferencia.appendChild(opt);
            });

            if (referencias.length > 0)
                filtroReferencia.disabled = false;

            // TALLAS
            const resTall = await fetch(`/Produccion/ObtenerTallasPorGenero?idGenero=${idGenero}`);

            if (!resTall.ok)
                throw new Error("Error cargando tallas");

            const tallas = await resTall.json();
            console.log("Tallas recibidas:", tallas);

            tallas.forEach(t => {
                const opt = document.createElement("option");
                opt.value = t.id;
                opt.textContent = t.descripcion;
                filtroTalla.appendChild(opt);
            });

            if (tallas.length > 0)
                filtroTalla.disabled = false;

        }
        catch (error) {
            console.error(error);
            contenedor.innerHTML =
                `<div class="text-danger">❌ Error al cargar referencias y tallas</div>`;
        }
    });

    // =============================
    // BUSCAR PRODUCTOS
    // =============================
    btnBuscar.addEventListener("click", async function () {

        const formData = new FormData(form);
        const params = new URLSearchParams();

        for (let [key, value] of formData.entries()) {
            if (value && value.trim() !== "")
                params.append(key, value);
        }

        if (!params.toString()) {
            contenedor.innerHTML =
                `<div class="text-muted">Seleccione al menos un criterio.</div>`;
            return;
        }

        contenedor.innerHTML =
            `<div class="text-muted">⏳ Consultando productos...</div>`;

        try {

            const r = await fetch(`/Produccion/BuscarProductos?${params.toString()}`);

            if (!r.ok)
                throw new Error("Error en búsqueda");

            const data = await r.json();

            if (!data.length) {
                contenedor.innerHTML =
                    `<div class="text-muted">No se encontraron productos.</div>`;
                return;
            }

            contenedor.innerHTML = `
            <table class="table table-bordered table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Género</th>
                        <th>Referencia</th>
                        <th>Talla</th>
                        <th class="text-end">Costo</th>
                        <th class="text-end">Precio Vta</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center">IVA %</th>
                        <th class="text-center">Activo</th>
                    </tr>
                </thead>
                <tbody>
                    ${data.map(p => `
                        <tr>
                            <td>${p.idProducto ?? ''}</td>
                            <td>${p.nombre ?? ''}</td>
                            <td>${p.genero ?? ''}</td>
                            <td>${p.referencia ?? ''}</td>
                            <td>${p.talla ?? ''}</td>
                            <td class="text-end">$${Number(p.precioCosto ?? 0).toFixed(2)}</td>
                            <td class="text-end">$${Number(p.precioVTA ?? 0).toFixed(2)}</td>
                            <td class="text-center">${p.stock ?? 0}</td>
                            <td class="text-center">${p.iva ?? 0}</td>
                            <td class="text-center">${p.activo ? '✔️' : '❌'}</td>
                        </tr>
                    `).join("")}
                </tbody>
            </table>`;
        }
        catch (error) {
            console.error(error);
            contenedor.innerHTML =
                `<div class="text-danger">❌ Error al consultar datos</div>`;
        }
    });

});
</script>

}
    
}