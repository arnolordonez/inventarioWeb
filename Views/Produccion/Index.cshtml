@model InventarioWEB.ViewModels.ProduccionPedidoDashboardVM

@{
    ViewData["Title"] = "Producción por Pedidos";
}

<div class="container-fluid">

    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <div class="row mb-3">

        <div class="col-md-6">

            <h3 class="fw-bold text-primary mb-1">
                🏭 Producción por Pedidos
            </h3>

            <p class="text-muted mb-0">
                Control operacional y seguimiento de pedidos en producción.
            </p>

        </div>

        <div class="col-md-6 text-end">

            <a asp-action="Crear"
               class="btn btn-success">

                ➕ Registrar Producción

            </a>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- ALERTA -->
    <!-- ========================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">

            <strong>✔</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- ========================================= -->
    <!-- DASHBOARD -->
    <!-- ========================================= -->

    <div class="row mb-4">

        <!-- PEDIDOS PENDIENTES -->

        <div class="col-md-3 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="text-muted small mb-2">
                        Pedidos pendientes
                    </div>

                    <h2 class="fw-bold text-danger mb-0">
                        @Model.TotalPedidosPendientes
                    </h2>

                </div>

            </div>

        </div>

        <!-- EN PRODUCCIÓN -->

        <div class="col-md-3 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="text-muted small mb-2">
                        En producción
                    </div>

                    <h2 class="fw-bold text-warning mb-0">
                        @Model.TotalPedidosEnProduccion
                    </h2>

                </div>

            </div>

        </div>

        <!-- COMPLETADOS -->

        <div class="col-md-3 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="text-muted small mb-2">
                        Completados
                    </div>

                    <h2 class="fw-bold text-success mb-0">
                        @Model.TotalPedidosCompletados
                    </h2>

                </div>

            </div>

        </div>

        <!-- UNIDADES PENDIENTES -->

        <div class="col-md-3 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div class="text-muted small mb-2">
                        Unidades pendientes
                    </div>

                    <h2 class="fw-bold text-dark mb-0">
                        @Model.TotalUnidadesPendientes
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- TABLA -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-light fw-bold">

            📋 Pedidos en Producción

        </div>

        <div class="card-body">

            @if (Model.Pedidos == null || !Model.Pedidos.Any())
            {
                <div class="alert alert-info mb-0">

                    No existen pedidos pendientes de producción.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle table-sm mb-0">


                        <thead class="table-light">

                            <tr>

                                <!-- PEDIDO -->

                                <th style="width:110px">
                                    Pedido
                                </th>

                                <!-- CLIENTE -->

                                <th>
                                    Cliente
                                </th>

                                <!-- TIPO VENTA -->

                                <th class="text-center" style="width:120px">
                                    Venta
                                </th>

                                <!-- ESTADO PAGO -->

                                <th class="text-center" style="width:140px">
                                    Estado Pago
                                </th>

                                <!-- DESPACHO -->

                                <th class="text-center" style="width:160px">
                                    Despacho
                                </th>

                                <!-- SALDO -->

                                <th class="text-end" style="width:140px">
                                    Saldo
                                </th>

                                <!-- TOTAL PEDIDO -->

                                <th class="text-center" style="width:120px">
                                    Pedido
                                </th>


                                <!-- PRODUCCIÓN / PENDIENTE -->
                                <th class="text-center" style="width:140px">
                                    Producción<br />
                                    <small class="text-muted">Pendiente</small>
                                </th>
                                
                                <!-- AVANCE -->

                                <th class="text-center" style="width:170px">
                                    Avance
                                </th>

                                <!-- ESTADO PRODUCCIÓN -->

                                <th class="text-center" style="width:160px">
                                    Producción
                                </th>

                                <!-- ÚLTIMA PRODUCCIÓN -->

                                <th class="text-center" style="width:140px">
                                    Última Prod.
                                </th>

                                <!-- ACCIONES -->

                                <th class="text-center" style="width:220px">
                                    Acción
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Pedidos)
                            {
                                <tr>

                                    <!-- PEDIDO -->

                                    <td>

                                        <div class="fw-bold text-primary">
                                            #@item.ID_Pedido
                                        </div>

                                        <small class="text-muted">
                                            @item.FechaPedido.ToString("dd/MM/yyyy")
                                        </small>

                                    </td>

                                    <!-- CLIENTE -->

                                    <td>

                                        <div class="fw-bold">
                                            @item.Cliente
                                        </div>

                                        <small class="text-muted">
                                            CC/NIT: @item.ID_Cliente
                                        </small>

                                    </td>

                                    <!-- TIPO VENTA -->

                                    <td class="text-center">

                                        @if (item.TipoVenta == "CREDITO")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                CRÉDITO
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                CONTADO
                                            </span>
                                        }

                                    </td>

                                    <!-- ESTADO PAGO -->

                                    <td class="text-center">

                                        @if (item.EstadoPago == "PAGADO")
                                        {
                                            <span class="badge bg-success">
                                                PAGADO
                                            </span>
                                        }
                                        else if (item.EstadoPago == "ABONADO")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                ABONADO
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                PENDIENTE
                                            </span>
                                        }

                                    </td>

                                    <!-- ESTADO LOGÍSTICO -->

                                    <td class="text-center">

                                        @if (item.Estado == "DESPACHADO")
                                        {
                                            <span class="badge bg-success">
                                                DESPACHADO
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                NO DESPACHADO
                                            </span>
                                        }

                                    </td>

                                    <!-- SALDO -->

                                    <td class="text-end fw-bold">

                                        @item.SaldoPendiente.ToString("C")

                                    </td>

                                    <!-- TOTAL PEDIDO -->

                                    <td class="text-center fw-bold">

                                        @item.TotalPedido

                                    </td>


                                    <!-- PRODUCCIÓN / PENDIENTE -->
                                    <td class="text-center fw-bold">

                                        <div class="text-success">
                                            ✔ @item.TotalProducido
                                        </div>

                                        <div class="text-danger small">
                                            ✖ @item.Pendiente
                                        </div>

                                    </td>
                                                                       

                                    <!-- AVANCE -->
                                    <td>

                                        <div class="position-relative">

                                            <div class="progress" style="height:22px;">

                                                <div class="progress-bar
                                                @(item.PorcentajeProduccion >= 100
                                                    ? "bg-success"
                                                    : item.PorcentajeProduccion > 0
                                                        ? "bg-warning"
                                                        : "bg-danger")"
                                                     role="progressbar"
                                                     style="width:@item.PorcentajeProduccion%">
                                                </div>

                                            </div>

                                            <!-- TEXTO SIEMPRE VISIBLE -->
                                            <div class="position-absolute top-50 start-50 translate-middle fw-bold small">

                                                @item.PorcentajeProduccion%

                                            </div>

                                        </div>

                                    </td>

                                    <!-- ESTADO PRODUCCIÓN -->

                                    <td class="text-center">

                                        @switch (item.EstadoProduccion)
                                        {
                                            case "COMPLETADO":

                                                <span class="badge bg-success">
                                                    COMPLETADO
                                                </span>

                                                break;

                                            case "EN PRODUCCIÓN":

                                                <span class="badge bg-warning text-dark">
                                                    EN PRODUCCIÓN
                                                </span>

                                                break;

                                            default:

                                                <span class="badge bg-danger">
                                                    PENDIENTE
                                                </span>

                                                break;
                                        }

                                    </td>

                                    <!-- ÚLTIMA PRODUCCIÓN -->

                                    <td class="text-center">

                                        @(item.UltimaProduccion.HasValue
                                            ? item.UltimaProduccion.Value.ToString("dd/MM/yyyy")
                                            : "-")

                                    </td>

                                    <!-- ACCIONES -->

                                    <td class="text-center">

                                        <div class="d-flex gap-1 justify-content-center flex-wrap">

                                            <a asp-action="CrearERP"
                                               asp-route-idPedido="@item.ID_Pedido"
                                               class="btn btn-sm btn-success">

                                                ➕ Producir

                                            </a>

                                            <a asp-action="Crear"
                                               asp-route-idPedido="@item.ID_Pedido"
                                               class="btn btn-sm btn-success">

                                                ➕ Producir

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>
                                               

                    </table>

                </div>

                <!-- ========================================= -->
                <!-- PAGINACIÓN -->
                <!-- ========================================= -->
                @if (Model.TotalPaginas > 1)
                {
                    <nav class="mt-4">

                        <ul class="pagination justify-content-center flex-wrap">

                            <li class="page-item @(Model.TienePaginaAnterior ? "" : "disabled")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@(Model.PaginaActual - 1)">

                                    ⬅ Anterior

                                </a>

                            </li>

                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pagina="@i">

                                        @i

                                    </a>

                                </li>
                            }

                            <li class="page-item @(Model.TienePaginaSiguiente ? "" : "disabled")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@(Model.PaginaActual + 1)">

                                    Siguiente ➡

                                </a>

                            </li>

                        </ul>

                    </nav>
                }

            }

        </div>

    </div>

</div>