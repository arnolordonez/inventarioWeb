@* ==========================================================
   PARCIAL: _ResultadosProduccion.cshtml
   Uso: Vista Crear Producción
   Fuente de datos: AJAX -> Produccion/BuscarProductos
   ========================================================== *@

<div class="card mt-3">
    <div class="card-header">
        <i class="bi bi-search"></i> Resultados de búsqueda
    </div>

    <div class="card-body p-2">

        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered align-middle mb-0">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 80px;">Código</th>
                        <th>Producto</th>
                        <th style="width: 90px;">Stock</th>
                        <th style="width: 110px;">Costo</th>
                        <th style="width: 90px;">Acción</th>
                    </tr>
                </thead>
                <tbody id="tablaResultadosProduccion">
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            Sin resultados
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {

    <script>

       
        // ===============================
        // 🔍 BUSCAR PRODUCTOS
        // ===============================
        async function buscarProductos() {

            const codigo     = document.getElementById("CodigoProducto")?.value;
            const referencia = document.getElementById("FiltroReferencia")?.value;
            const talla      = document.getElementById("FiltroTalla")?.value;
            const tela       = document.getElementById("FiltroTela")?.value;
            const color      = document.getElementById("FiltroColor")?.value;

            // 🚫 No buscar si no hay filtros
            if ([codigo, referencia, talla, tela, color].every(v => !v || v === "0")) {
                return;
            }

            const params = new URLSearchParams();

            if (codigo && codigo !== "0")
                params.append("idProducto", codigo);

            if (referencia && referencia !== "0")
                params.append("idReferencia", referencia);

            if (talla && talla !== "0")
                params.append("idTalla", talla);

            if (tela && tela !== "0")
                params.append("idTela", tela);

            if (color && color !== "0")
                params.append("idColor", color);

            const url = `/Produccion/BuscarProductos?${params.toString()}`;

            const response = await fetch(url);

            if (!response.ok) {
                alert("Error en la búsqueda.");
                return;
            }

            const data = await response.json();

            const tbody = document.getElementById("tablaResultadosProduccion");
            tbody.innerHTML = "";

            if (!data || data.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No se encontraron productos
                        </td>
                    </tr>`;
                return;
            }

            data.forEach(p => {

                const nombreSeguro = (p.nombre ?? "").replace(/'/g, "\\'");

                const fila = `
                    <tr>
                        <td class="text-center">${p.id_Producto ?? ""}</td>

                        <td>
                            ${p.nombre ?? ""} -
                            ${p.referencia ?? ""} -
                            ${p.talla ?? ""} -
                            ${p.tela ?? ""} -
                            ${p.color ?? ""}
                        </td>

                        <td class="text-center">
                            ${p.stock}
                        </td>

                        <td class="text-end">
                            ${Number(p.precioCosto).toLocaleString('es-CO', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            })}
                        </td>

                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    onclick="agregarAlDetalle(${p.id_Producto}, '${nombreSeguro}', ${p.precioCosto})">
                                Agregar
                            </button>
                        </td>
                    </tr>
                `;

                tbody.insertAdjacentHTML("beforeend", fila);
            });
        }
    

        // ===============================
        // ➕ AGREGAR AL DETALLE
        // ===============================
        function agregarAlDetalle(idProducto, nombreProducto, costoUnitario) {

            const tablaDetalle = document.querySelector("#tablaDetalles tbody");

            if (!tablaDetalle) {
                console.error("No se encontró #tablaDetalles tbody");
                return;
            }

            // Evitar duplicados
            if (document.querySelector(`input[value='${idProducto}'][name*='ID_Producto']`)) {
                alert("Este producto ya fue agregado.");
                return;
            }

            const index = tablaDetalle.rows.length;

            const fila = `
                <tr>
                    <td>
                        <input type="hidden"
                               name="Detalles[${index}].ID_Producto"
                               value="${idProducto}" />

                        <input type="hidden"
                               name="Detalles[${index}].CostoUnitario"
                               value="${costoUnitario}" />

                        ${nombreProducto}
                    </td>

                    <td>
                        <input type="number"
                               name="Detalles[${index}].Cantidad"
                               class="form-control form-control-sm"
                               min="1"
                               required />
                    </td>

                    <td class="text-center">
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                onclick="this.closest('tr').remove();">
                            X
                        </button>
                    </td>
                </tr>
            `;

            tablaDetalle.insertAdjacentHTML("beforeend", fila);
        }

    </script>

}