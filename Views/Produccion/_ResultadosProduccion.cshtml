@model IEnumerable<InventarioWEB.Models.Producto>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning mb-0">
        No se encontraron productos con los filtros seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-primary text-center">
                <tr>
                    <th>Código</th>
                    <th>Referencia</th>
                    <th>Tela</th>
                    <th>Talla</th>
                    <th>Color</th>
                    <th>Stock</th>
                    <th>Producción</th>
                    <th>Costo</th>
                    <th>Venta</th>
                    <th>IVA %</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr data-id="@p.ID_Producto">
                        <td class="text-center">@p.ID_Producto</td>
                        <td>@p.Referencia?.DescripReferencia</td>
                        <td>@p.Tela?.DescripTela</td>
                        <td class="text-center">@p.Talla?.DescripTalla</td>
                        <td class="text-center">@p.ColorNav?.Nombre</td>
                        <td class="text-center fw-bold stock">@p.Stock</td>

                        <!-- CANTIDAD PRODUCIDA -->
                        <td>
                            <input type="number"
                                   class="form-control form-control-sm cantidad"
                                   min="1"
                                   value="1" />
                        </td>

                        <!-- PRECIOS -->
                        <td>
                            <input type="number"
                                   class="form-control form-control-sm precio-costo"
                                   step="0.01"
                                   min="0"
                                   value="@p.PrecioCosto" />
                        </td>

                        <td>
                            <input type="number"
                                   class="form-control form-control-sm precio-vta"
                                   step="0.01"
                                   min="0"
                                   value="@p.PrecioVTA" />
                        </td>

                        <td>
                            <input type="number"
                                   class="form-control form-control-sm iva"
                                   step="0.01"
                                   min="0"
                                   max="100"
                                   value="@p.IVA_Porcentaje" />
                        </td>

                        <!-- ACCIÓN -->
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-success btn-sm btn-actualizar">
                                ➕ Actualizar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script>
        document.querySelectorAll(".btn-actualizar").forEach(btn => {

            btn.addEventListener("click", function () {

                const row = this.closest("tr");

                const idProducto = row.dataset.id;
                const cantidad = parseInt(row.querySelector(".cantidad").value);
                const precioCosto = parseFloat(row.querySelector(".precio-costo").value);
                const precioVta = parseFloat(row.querySelector(".precio-vta").value);
                const iva = parseFloat(row.querySelector(".iva").value);

                // ===============================
                // VALIDACIONES CLIENTE
                // ===============================
                if (cantidad <= 0) {
                    alert("La cantidad producida debe ser mayor a cero.");
                    return;
                }

                if (precioCosto < 0 || precioVta < 0) {
                    alert("Los precios no pueden ser negativos.");
                    return;
                }

                if (precioVta < precioCosto) {
                    alert("El precio de venta no puede ser menor al costo.");
                    return;
                }

                if (iva < 0 || iva > 100) {
                    alert("El IVA debe estar entre 0 y 100.");
                    return;
                }

                const data = new FormData();
                data.append("idProducto", idProducto);
                data.append("cantidadProducida", cantidad);
                data.append("precioCosto", precioCosto);
                data.append("precioVta", precioVta);
                data.append("iva", iva);

                fetch("/Produccion/ActualizarInventario", {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken":
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: data
                })
                .then(r => {
                    if (!r.ok) throw new Error("Error al actualizar inventario");
                    return r.text();
                })
                .then(msg => {
                    alert(msg);

                    // Actualizar stock visual
                    const stockCell = row.querySelector(".stock");
                    stockCell.textContent =
                        parseInt(stockCell.textContent) + cantidad;

                    row.querySelector(".cantidad").value = 1;
                })
                .catch(err => {
                    alert("❌ " + err.message);
                });
            });

        });
    </script>
}
