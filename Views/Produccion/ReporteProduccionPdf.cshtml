@model IEnumerable<InventarioWEB.Models.Producto>
@{
    Layout = null;
    var fecha = DateTime.Now;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        body { font-family: Arial; font-size: 11px; }
        h1 { text-align: center; margin-bottom: 5px; }
        .meta { text-align: center; font-size: 10px; margin-bottom: 15px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #000; padding: 4px; }
        th { background-color: #f0f0f0; }
        tfoot td { font-weight: bold; }
    </style>
</head>
<body>

    <h1>CONFESIONES INDOMABLE</h1>

    <div class="meta">
        Reporte de Producción<br />
        Fecha impresión: @fecha.ToString("dd/MM/yyyy HH:mm")<br />
        Usuario: @User.Identity?.Name ?? "Sistema"
    </div>

    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Referencia</th>
                <th>Tela</th>
                <th>Talla</th>
                <th>Color</th>
                <th>Stock</th>
                <th>Costo</th>
                <th>Venta</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.ID_Producto</td>
                    <td>@p.Referencia?.DescripReferencia</td>
                    <td>@p.Tela?.DescripTela</td>
                    <td>@p.Talla?.DescripTalla</td>
                    <td>@p.ColorNav?.Nombre</td>
                    <td>@p.Stock</td>
                    <td>@p.PrecioCosto</td>
                    <td>@p.PrecioVTA</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5">TOTALES</td>
                <td>@Model.Sum(x => x.Stock)</td>
                <td>@Model.Sum(x => x.Stock * x.PrecioCosto)</td>
                <td>@Model.Sum(x => x.Stock * x.PrecioVTA)</td>
            </tr>
        </tfoot>
    </table>

</body>
</html>
