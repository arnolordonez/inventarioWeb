@model IEnumerable<InventarioWEB.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-people-fill me-2"></i>
            Gestión de Usuarios
        </h2>

        <small class="text-muted">
            Administración de usuarios y roles del sistema
        </small>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-2"></i>
        Nuevo Usuario
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-header bg-light">
        <strong>
            Listado de Usuarios
            (@Model.Count() registros)
        </strong>

    </div>

    <div class="card-body">


        @if (TempData["success"] != null)
        {
            <div class="alert alert-success">
                @TempData["success"]
            </div>
        }

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["error"]
            </div>
        }

        

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No existen usuarios registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre Completo</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th width="180">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.IdUsuario
                                </td>

                                <td>
                                    @item.Nombres @item.Apellidos
                                </td>

                                <td>
                                    @item.Correo
                                </td>

                                <td>
                                    @item.Rol?.NombreRol
                                </td>

                                <td>

                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.IdUsuario"
                                       class="btn btn-warning btn-sm"
                                       title="Editar usuario">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>
                                                                        
                                    @if (item.Activo)
                                    {
                                        <a asp-action="Desactivar"
                                           asp-route-id="@item.IdUsuario"
                                           class="btn btn-danger btn-sm"
                                           title="Desactivar usuario"
                                           onclick="return confirm('¿Desea desactivar este usuario?');">

                                            <i class="bi bi-person-x-fill"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Activar"
                                           asp-route-id="@item.IdUsuario"
                                           class="btn btn-success btn-sm"
                                           title="Activar usuario"
                                           onclick="return confirm('¿Desea activar este usuario?');">

                                            <i class="bi bi-person-check-fill"></i>
                                        </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>