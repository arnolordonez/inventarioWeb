@model InventarioWEB.ViewModels.UsuarioEditViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-pencil-square me-2"></i>
            Editar Usuario
        </h2>

        <small class="text-muted">
            Actualización de información del usuario
        </small>
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Volver
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-header bg-light">
        <strong>Información del Usuario</strong>
    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="IdUsuario" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row">

                <!-- NOMBRES -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Nombres"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Nombres"
                           class="form-control" />

                    <span asp-validation-for="Nombres"
                          class="text-danger"></span>

                </div>

                <!-- APELLIDOS -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Apellidos"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Apellidos"
                           class="form-control" />

                    <span asp-validation-for="Apellidos"
                          class="text-danger"></span>

                </div>

                <!-- CORREO -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Correo"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Correo"
                           class="form-control" />

                    <span asp-validation-for="Correo"
                          class="text-danger"></span>

                </div>

                <!-- ROL -->
                <div class="col-md-6 mb-3">

                    <label asp-for="IdRol"
                           class="form-label fw-bold">
                        Rol
                    </label>

                    <select asp-for="IdRol"
                            class="form-select">

                        @foreach (var rol in ViewBag.Roles)
                        {
                            <option value="@rol.IdRol">
                                @rol.NombreRol
                            </option>
                        }

                    </select>

                    <span asp-validation-for="IdRol"
                          class="text-danger"></span>

                </div>

                <!-- ACTIVO -->
                <div class="col-md-12 mb-4">

                    <div class="form-check">

                        <input asp-for="Activo"
                               class="form-check-input" />

                        <label asp-for="Activo"
                               class="form-check-label">
                            Usuario Activo
                        </label>

                    </div>

                </div>

            </div>

            <hr />

            <h5 class="mb-3">
                Cambio de Contraseña (Opcional)
            </h5>

            <div class="row">

                <!-- NUEVA CONTRASEÑA -->
                <div class="col-md-6 mb-3">

                    <label asp-for="NuevaContrasena"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="NuevaContrasena"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="NuevaContrasena"
                          class="text-danger"></span>

                </div>

                <!-- CONFIRMAR -->
                <div class="col-md-6 mb-3">

                    <label asp-for="ConfirmarContrasena"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="ConfirmarContrasena"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="ConfirmarContrasena"
                          class="text-danger"></span>

                </div>

            </div>

            <hr />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save me-2"></i>
                    Guardar Cambios

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-x-circle me-2"></i>
                    Cancelar

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}