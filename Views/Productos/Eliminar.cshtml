@model InventarioWEB.Models.Producto

@{
    ViewData["Title"] = "Desactivar Producto";
}

<div class="container mt-4">

    <h2 class="text-center mb-4 text-danger fw-bold">
        🗑️ Desactivar Producto
    </h2>

    <div class="alert alert-warning shadow-sm text-center">
        <p class="mb-0">
            ¿Estás seguro de que deseas <strong>desactivar</strong> este producto?
            <br />
            <small class="text-muted">
                (La eliminación es lógica y puede revertirse)
            </small>
        </p>
    </div>

    <div class="card mb-3 shadow-sm">
        <div class="card-body">

            <h5 class="card-title fw-bold">
                @Model.Nombre
            </h5>

            <p class="card-text"><strong>ID:</strong> @Model.ID_Producto</p>
            <p class="card-text"><strong>Referencia:</strong> @(Model.Referencia?.DescripReferencia ?? "—")</p>
            <p class="card-text"><strong>Género:</strong> @(Model.Referencia?.Genero?.DescripGenero ?? "—")</p>
            <p class="card-text"><strong>Talla:</strong> @(Model.Talla?.DescripTalla ?? "—")</p>
            <p class="card-text"><strong>Tela:</strong> @(Model.Tela?.DescripTela ?? "—")</p>
            <p class="card-text"><strong>Color:</strong> @(Model.ColorNav?.Nombre ?? "—")</p>
            <p class="card-text"><strong>Precio Venta:</strong> @(Model.PrecioVTA.ToString("C"))</p>
            <p class="card-text"><strong>IVA (%):</strong> @($"{Model.IVA_Porcentaje:0.##}")</p>
            <p class="card-text"><strong>Stock:</strong> @Model.Stock</p>

            <p class="card-text">
                <strong>Estado:</strong>
                <span class="badge @(Model.Activo ? "bg-success" : "bg-secondary")">
                    @(Model.Activo ? "Activo" : "Inactivo")
                </span>
            </p>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3">

        <!-- DESACTIVACIÓN LÓGICA -->
        <form asp-controller="Productos"
              asp-action="CambiarEstado"
              asp-route-id="@Model.ID_Producto"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger px-4 shadow-sm">
                <i class="bi bi-trash"></i> Confirmar desactivación
            </button>
        </form>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-secondary px-4 shadow-sm">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>

    </div>
</div>
