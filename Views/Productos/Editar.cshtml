@model InventarioWEB.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<h2 class="text-center text-primary fw-bold mb-4">
    ✏️ Editar Producto
</h2>

<div class="card shadow-lg p-4 rounded-3" style="max-width: 700px; margin:auto;">
    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()

        <!-- ID -->
        <input type="hidden" asp-for="ID_Producto" />

        <!-- REFERENCIA (NO EDITABLE) -->
        <div class="mb-3">
            <label class="form-label fw-bold">Referencia</label>
            <input type="text"
                   class="form-control bg-light"
                   value="@Model.Referencia?.DescripReferencia"
                   readonly />
            <input type="hidden" asp-for="ID_Referencias" />
        </div>

        <!-- TALLA (NO EDITABLE) -->
        <div class="mb-3">
            <label class="form-label fw-bold">Talla</label>
            <input type="text"
                   class="form-control bg-light"
                   value="@Model.Talla?.DescripTalla"
                   readonly />
            <input type="hidden" asp-for="ID_Tallas" />
        </div>

        <!-- TELA -->
        <div class="mb-3">
            <label asp-for="ID_Telas" class="form-label fw-bold">Tela</label>
            <select asp-for="ID_Telas"
                    class="form-select"
                    asp-items="ViewBag.Telas ?? new List<SelectListItem>()">
                <option value="">Seleccione una tela</option>
            </select>
            <span asp-validation-for="ID_Telas" class="text-danger"></span>
        </div>

        <!-- COLOR -->
        <div class="mb-3">
            <label asp-for="ID_Color" class="form-label fw-bold">Color</label>
            <select asp-for="ID_Color"
                    class="form-select"
                    asp-items="ViewBag.Colores ?? new List<SelectListItem>()">
                <option value="">Seleccione un color</option>
            </select>
            <span asp-validation-for="ID_Color" class="text-danger"></span>
        </div>

        <!-- STOCK -->
        <div class="mb-3">
            <label asp-for="Stock" class="form-label fw-bold">Stock</label>
            <input asp-for="Stock"
                   type="number"
                   min="0"
                   step="1"
                   class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <!-- PRECIO COSTO -->
        <div class="mb-3">
            <label asp-for="PrecioCosto" class="form-label fw-bold">Precio Costo</label>
            <input asp-for="PrecioCosto"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control" />
            <span asp-validation-for="PrecioCosto" class="text-danger"></span>
        </div>

        <!-- PRECIO VENTA -->
        <div class="mb-3">
            <label asp-for="PrecioVTA" class="form-label fw-bold">Precio Venta</label>
            <input asp-for="PrecioVTA"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control" />
            <span asp-validation-for="PrecioVTA" class="text-danger"></span>
        </div>

        <!-- IVA -->
        <div class="mb-3">
            <label asp-for="IVA_Porcentaje" class="form-label fw-bold">IVA (%)</label>
            <input asp-for="IVA_Porcentaje"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control" />
            <span asp-validation-for="IVA_Porcentaje" class="text-danger"></span>
        </div>

        <!-- NOMBRE AUTO-GENERADO -->
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
            <input asp-for="Nombre"
                   class="form-control bg-light"
                   readonly />
        </div>

        <!-- ACTIVO -->
        <div class="form-check mb-4">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label fw-bold">
                Activo
            </label>
        </div>

        <!-- BOTONES -->
        <div class="text-center">
            <button type="submit" class="btn btn-success px-4">
                💾 Guardar
            </button>
            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">
                ⬅ Volver
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            function generarNombre() {
                // Uso de JSON.stringify para escapar cualquier carácter especial
                const referencia = @Html.Raw(Json.Serialize(Model.Referencia?.DescripReferencia ?? ""));
                const talla = @Html.Raw(Json.Serialize(Model.Talla?.DescripTalla ?? ""));

                const telaSelect = document.querySelector("[name='ID_Telas']");
                const colorSelect = document.querySelector("[name='ID_Color']");

                if (!telaSelect || !colorSelect) return;

                const tela = telaSelect.selectedOptions[0]?.text || '';
                const color = colorSelect.selectedOptions[0]?.text || '';

                const partes = [referencia, talla, tela, color]
                    .filter(x => x && !x.includes("Seleccione"));

                document.querySelector("[name='Nombre']").value = partes.join(" - ");
            }

            document.querySelector("[name='ID_Telas']")?.addEventListener("change", generarNombre);
            document.querySelector("[name='ID_Color']")?.addEventListener("change", generarNombre);

            generarNombre();
        });
    </script>
}
