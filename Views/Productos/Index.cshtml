@model InventarioWEB.ViewModels.ProductosIndexViewModel

@{
    ViewData["Title"] = "Productos - InventarioWEB";
}

<div class="container mt-4">

    <h2 class="text-center mb-4 fw-bold text-primary">
        📋 Gestión de Productos
    </h2>

    <!-- FORMULARIO DE FILTROS -->
    <form id="form-filtros" asp-action="Index" method="get"
          class="row g-3 mb-4 shadow-sm p-3 rounded bg-light">

        <!-- CÓDIGO -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Código</label>
            <input asp-for="ID_Producto"
                   type="number"
                   class="form-control"
                   placeholder="Ej: 12345" />
        </div>

        <!-- GÉNERO -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Género</label>
            <select id="ID_Genero" name="ID_Genero" class="form-select">
                <option value="">Seleccione...</option>
                @foreach (var g in Model.Generos)
                {
                    <option value="@g.Value"
                            selected="@(Model.ID_Genero?.ToString() == g.Value)">
                        @g.Text
                    </option>
                }
            </select>
        </div>

        <!-- REFERENCIA -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Referencia</label>
            <select id="ID_Referencia" name="ID_Referencia" class="form-select">
                <option value="">Todas</option>
                @foreach (var r in Model.Referencias)
                {
                    <option value="@r.Value"
                            data-id-genero="@r.ID_Genero"
                            selected="@(Model.ID_Referencia?.ToString() == r.Value)">
                        @r.Text
                    </option>
                }
            </select>
        </div>

        <!-- TALLA -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Talla</label>
            <select id="ID_Talla" name="ID_Talla" class="form-select">
                <option value="">Todas</option>
                @foreach (var t in Model.Tallas)
                {
                    <option value="@t.Value"
                            data-id-genero="@t.ID_Genero"
                            selected="@(Model.ID_Talla?.ToString() == t.Value)">
                        @t.Text
                    </option>
                }
            </select>
        </div>

        <!-- TELA -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Tela</label>
            <select asp-for="ID_Tela"
                    asp-items="Model.Telas"
                    class="form-select">
                <option value="">Todas</option>
            </select>
        </div>

        <!-- ESTADO -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Estado</label>
            <select asp-for="EstadoFiltro"
                    asp-items="Model.EstadosLista"
                    class="form-select">
                <option value="">Todos</option>
            </select>
        </div>

        <!-- BOTONES -->
        <div class="col-12 d-flex justify-content-end gap-2 mt-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Buscar
            </button>

            <a asp-action="Crear" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Nuevo Producto
            </a>
        </div>
    </form>

    <!-- RESULTADOS -->
    <div id="productos-resultados">
        @await Html.PartialAsync("_ProductosTabla", Model)
    </div>

</div>

<!-- =========================
     SCRIPT AJAX PARA FILTROS Y PAGINACIÓN
     ========================= -->
@section Scripts {
    <script>
        $(function () {

            function actualizarResultados(data) {
                var $html = $('<div>').html(data);
                var contenido = $html.find('#productos-resultados').html();

                // Si viene vista completa
                if (contenido !== undefined) {
                    $('#productos-resultados').html(contenido);
                }
                // Si viene directamente el partial
                else {
                    $('#productos-resultados').html(data);
                }
            }

            // Submit filtros
            $('#form-filtros').on('submit', function (e) {
                e.preventDefault();

                var url = $(this).attr('action') + '?' + $(this).serialize();

                $.get(url, actualizarResultados);
            });

            // Paginación
            $('#productos-resultados').on('click', '.pagination a', function (e) {
                e.preventDefault();

                $.get($(this).attr('href'), actualizarResultados);
            });
        });
    </script>
}
}
