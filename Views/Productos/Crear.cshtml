@model InventarioWEB.ViewModels.ProductoCreateViewModel

@{
    ViewData["Title"] = "Crear Producto";
}

<h2 class="mb-4 fw-bold">Crear Nuevo Producto</h2>

<div class="card shadow-sm border-0 p-4">

    <form asp-action="Crear" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="row g-3">

            <!-- GÉNERO (SOLO FILTRO UI) -->
            <div class="col-md-4">
                <label asp-for="ID_Genero" class="form-label fw-semibold">Género</label>
                <select asp-for="ID_Genero"
                        class="form-select"
                        asp-items="Model.GenerosLista"
                        id="GeneroSelect"
                        tabindex="1">
                    <option value="">Seleccione un género</option>
                </select>
            </div>

            <!-- REFERENCIA -->
            <div class="col-md-4">
                <label asp-for="ID_Referencias" class="form-label fw-semibold">Referencia</label>
                <select asp-for="ID_Referencias"
                        class="form-select"
                        id="ReferenciaSelect"
                        tabindex="2">
                    <option value="">Seleccione género primero</option>
                </select>
                <span asp-validation-for="ID_Referencias" class="text-danger small"></span>
            </div>

            <!-- TALLA -->
            <div class="col-md-4">
                <label asp-for="ID_Tallas" class="form-label fw-semibold">Talla</label>
                <select asp-for="ID_Tallas"
                        class="form-select"
                        id="TallaSelect"
                        tabindex="3">
                    <option value="">Seleccione referencia primero</option>
                </select>
                <span asp-validation-for="ID_Tallas" class="text-danger small"></span>
            </div>

            <!-- TELA -->
            <div class="col-md-4">
                <label asp-for="ID_Telas" class="form-label fw-semibold">Tela</label>
                <select asp-for="ID_Telas"
                        class="form-select"
                        asp-items="Model.TelasLista"
                        tabindex="4">
                    <option value="">Seleccione</option>
                </select>
                <span asp-validation-for="ID_Telas" class="text-danger small"></span>
            </div>

            <!-- COLOR -->
            <div class="col-md-4">
                <label asp-for="ID_Color" class="form-label fw-semibold">Color</label>
                <select asp-for="ID_Color"
                        class="form-select"
                        asp-items="Model.ColoresLista"
                        tabindex="5">
                    <option value="">Seleccione</option>
                </select>
                <span asp-validation-for="ID_Color" class="text-danger small"></span>
            </div>

            <!-- PRECIO COSTO -->
            <div class="col-md-4">
                <label asp-for="PrecioCosto" class="form-label fw-semibold">Precio Costo</label>
                <input asp-for="PrecioCosto" type="number" min="0.01" step="0.01" class="form-control" tabindex="6" />
                <span asp-validation-for="PrecioCosto" class="text-danger small"></span>
            </div>

            <!-- PRECIO VENTA -->
            <div class="col-md-4">
                <label asp-for="PrecioVTA" class="form-label fw-semibold">Precio Venta</label>
                <input asp-for="PrecioVTA" type="number" min="0.01" step="0.01" class="form-control" tabindex="7" />
                <span asp-validation-for="PrecioVTA" class="text-danger small"></span>
            </div>

            <!-- STOCK -->
            <div class="col-md-4">
                <label asp-for="Stock" class="form-label fw-semibold">Stock</label>
                <input asp-for="Stock" type="number" min="0" step="1" class="form-control" tabindex="8" />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>

            <!-- IVA -->
            <div class="col-md-4">
                <label asp-for="IVA_Porcentaje" class="form-label fw-semibold">IVA (%)</label>
                <input asp-for="IVA_Porcentaje" type="number" min="0" step="0.01" class="form-control" tabindex="9" />
                <span asp-validation-for="IVA_Porcentaje" class="text-danger small"></span>
            </div>

        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-4">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            // ==========================================
            // FUNCIÓN AUXILIAR
            // ==========================================
            function option(value, text) {
                if (!value || !text) return '';
                return '<option value="' + value + '">' + text + '</option>';
            }

            // ==========================================
            // REFERENCIAS POR GÉNERO
            // ==========================================
            $("#GeneroSelect").change(function () {

                var generoId = $(this).val();
                console.log("🟢 Género:", generoId);

                $("#ReferenciaSelect").html('');
                $("#TallaSelect").html('<option value="">Seleccione referencia primero</option>');

                if (!generoId) {
                    $("#ReferenciaSelect").html('<option value="">Seleccione género primero</option>');
                    return;
                }

                $.getJSON('/Productos/ReferenciasPorGenero/' + generoId)
                    .done(function (data) {

                        console.log("📦 DATA:", data);

                        var html = '<option value="">Seleccione</option>';

                        $.each(data, function (i, item) {

                            console.log("➡️ Item:", item);

                                html += option(
                                       item.ID_Referencias,
                                       item.DescripReferencia
                                );

                           
                        });

                        $("#ReferenciaSelect").html(html);
                    })
                    .fail(function (err) {
                        console.error("❌ ERROR:", err);
                    });
            });

          // ==========================================
        // TALLAS POR GÉNERO (dependen de Género)
        // ==========================================
        $("#ReferenciaSelect").change(function () {

            var refId = $(this).val();
            console.log("🟢 Referencia:", refId);

            $("#TallaSelect").html('');

            if (!refId) {
                $("#TallaSelect").html('<option value="">Seleccione referencia primero</option>');
                return;
            }

            const generoId = $("#GeneroSelect").val();

            $.getJSON("/Productos/TallasPorGenero/" + generoId, function (data) {

                console.log("📦 Tallas:", data);

                var html = '<option value="">Seleccione</option>';

                $.each(data, function (i, item) {

                    html += option(
                        item.iD_Tallas || item.ID_Tallas,
                        item.descripTalla || item.DescripTalla
                    );

                });

                $("#TallaSelect").html(html);

            })
            .fail(function (err) {
                console.error("❌ ERROR Tallas:", err);
            });
        });

        });
    </script>
}