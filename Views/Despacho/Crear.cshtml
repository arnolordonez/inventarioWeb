@model InventarioWEB.ViewModels.DespachoTallaViewModel

@{
    ViewData["Title"] = "Crear Despacho";
}


<h2 class="mb-4">📦 Crear Despacho</h2>
@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger text-center shadow-sm">

        <h5 class="fw-bold mb-2">
            🚫 Despacho bloqueado
        </h5>

        <div class="fw-semibold">
            @ViewBag.Mensaje
        </div>

        <div class="small mt-2 text-dark">

            No existen unidades producidas disponibles
            para generar el despacho del pedido.

        </div>

    </div>
}

          @*
            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-warning text-center fw-bold">
                    @ViewBag.Mensaje
                </div>
            }
            *@
           
<!-- =========================================
     📊 INFORMACIÓN DEL PEDIDO
========================================= -->
<div class="alert alert-info">
    <strong>Pedido:</strong> #@Model.ID_Pedido <br />
    <strong>Total Pedido:</strong> @Model.TotalDocenasPedido docenas
</div>

<!-- =========================================
     ❌ ERRORES
========================================= -->
<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="Crear" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ID_Pedido" />

    <table class="table table-bordered align-middle">

        <thead class="table-dark text-center">
            <tr>
                <th>Talla</th>
                <th>Pedido</th>
                <th>Despachado</th>
                <th>Pendiente</th>
                <th>Producción</th>
                <th style="width:220px;">Confirmar</th>
            </tr>
        </thead>

        <tbody>

            @for (int i = 0; i < Model.Tallas.Count; i++)
            {
                var item = Model.Tallas[i];

                var sinPendiente =
                item.CantidadPendiente <= 0;

                var sinProduccion =
                item.CantidadDisponible <= 0;

                var bloqueado =
                sinPendiente || sinProduccion;

                // 🔥 DESPACHO AUTOMÁTICO
                var cantidadDespacho =
                Math.Min(
                item.CantidadPendiente,
                item.CantidadDisponible
                );

                <tr>

                    <!-- ================================= -->
                    <!-- TALLA -->
                    <!-- ================================= -->

                    <td>

                        <strong>@item.Talla</strong>

                        <input type="hidden"
                               asp-for="Tallas[i].ID_Detalle" />

                        <input type="hidden"
                               asp-for="Tallas[i].ID_Producto" />

                        <input type="hidden"
                               asp-for="Tallas[i].Cantidad"
                               class="cantidad-hidden"
                               value="0" />

                    </td>

                    <!-- ================================= -->
                    <!-- PEDIDO -->
                    <!-- ================================= -->

                    <td class="text-center fw-bold">
                        @item.CantidadPedida
                    </td>

                    <!-- ================================= -->
                    <!-- DESPACHADO -->
                    <!-- ================================= -->

                    <td class="text-center text-success fw-bold">
                        @item.CantidadDespachada
                    </td>

                    <!-- ================================= -->
                    <!-- PENDIENTE -->
                    <!-- ================================= -->

                    <td class="text-center">

                        @if (sinPendiente)
                        {
                            <span class="badge bg-success">
                                ✔ Completado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @item.CantidadPendiente doc
                            </span>
                        }

                    </td>

                    <!-- ================================= -->
                    <!-- PRODUCCIÓN DISPONIBLE -->
                    <!-- ================================= -->

                    <td class="text-center">

                        @if (sinProduccion)
                        {
                            <span class="badge bg-danger">
                                Sin producción
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary">
                                @item.CantidadDisponible doc
                            </span>
                        }

                    </td>

                    <!-- ================================= -->
                    <!-- CONFIRMAR -->
                    <!-- ================================= -->

                    <td class="text-center">

                        @if (bloqueado)
                        {
                            <input type="checkbox"
                                   disabled />

                            <div class="small text-muted mt-1">

                                @(sinPendiente
                                    ? "Despacho completo"
                                    : "Sin producción disponible")

                            </div>
                        }
                        else
                        {
                            <div class="form-check d-flex justify-content-center">

                                <input type="checkbox"
                                       class="form-check-input despacho-check"
                                       data-index="@i"
                                       data-cantidad="@cantidadDespacho" />

                            </div>

                            <div class="small text-primary mt-1 fw-bold">

                                Despachar:
                                @cantidadDespacho doc

                            </div>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

    <!-- =========================================
         RESUMEN
    ========================================= -->

    <div class="alert alert-secondary mt-3">

        <strong>Total a despachar:</strong>

        <span id="totalDocenas">0</span> docenas

    </div>

    <!-- =========================================
         BOTONES
    ========================================= -->
    <!-- =========================================
         BOTONES
    ========================================= -->
    @{
        var sinExistencias =
        Model.Tallas.All(x =>
        x.CantidadDisponible <= 0 ||
        x.CantidadPendiente <= 0);
    }

    <div class="mt-3 d-flex gap-2">

        @if (sinExistencias)
        {
            <button type="button"
                    class="btn btn-secondary"
                    disabled>

                Sin existencias disponibles

            </button>
        }
        else
        {
            <button type="submit"
                    class="btn btn-primary">

                ✔ Confirmar Despacho

            </button>
        }

        <a asp-action="Index"
           class="btn btn-secondary">

            Cancelar

        </a>

    </div>
 

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // =========================================
        // SYNC HIDDEN
        // =========================================

        function syncHidden(index, value) {

            document.querySelectorAll(".cantidad-hidden")[index].value = value;
        }

        // =========================================
        // RECALCULAR TOTAL
        // =========================================

        function recalcularTotalDocenas() {

            let total = 0;

            document.querySelectorAll(".cantidad-hidden")
                .forEach(input => {

                    total += parseInt(input.value) || 0;
                });

            document.getElementById("totalDocenas").innerText = total;
        }

        // =========================================
        // CHECKBOX EVENT
        // =========================================

        document.querySelectorAll(".despacho-check")
            .forEach(check => {

                check.addEventListener("change", function () {

                    const index =
                        this.dataset.index;

                    const cantidad =
                        parseInt(this.dataset.cantidad) || 0;

                    if (this.checked) {
                        syncHidden(index, cantidad);
                    }
                    else {
                        syncHidden(index, 0);
                    }

                    recalcularTotalDocenas();
                });
            });

        // =========================================
        // INIT
        // =========================================

        document.addEventListener("DOMContentLoaded", function () {

            recalcularTotalDocenas();

        });

    </script>
}