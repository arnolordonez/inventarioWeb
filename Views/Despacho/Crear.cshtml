@model InventarioWEB.ViewModels.DespachoTallaViewModel

@{
    ViewData["Title"] = "Crear Despacho";
}

<h2 class="mb-4">📦 Crear Despacho</h2>

<!-- =========================================
     📊 INFORMACIÓN DEL PEDIDO
========================================= -->
<div class="alert alert-info">
    <strong>Pedido:</strong> #@Model.ID_Pedido <br />
    <strong>Total Pedido:</strong> @Model.TotalDocenasPedido docenas
</div>

<!-- 🔥 MOSTRAR ERRORES -->
<div asp-validation-summary="All" class="text-danger mb-3"></div>


<form asp-action="Crear" method="post">

    <input type="hidden" asp-for="ID_Pedido" />

    <!-- =========================================
         ❌ ERRORES
    ========================================= -->
    

    <table class="table table-bordered align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Talla</th>
                <th>Pedido</th>
                <th>Despachado</th>
                <th>Pendiente</th>
                <th style="width:180px;">Despachar</th>
            </tr>
        </thead>

        <tbody>

            @for (int i = 0; i < Model.Tallas.Count; i++)
            {
                var item = Model.Tallas[i];
                var sinPendiente = item.CantidadPendiente <= 0;

                <tr>

                    <!-- TALLA -->
                    <td>
                        <strong>@item.Talla</strong>

                        <input type="hidden" asp-for="Tallas[i].ID_Detalle" />
                        <input type="hidden" asp-for="Tallas[i].ID_Producto" />

                        <!-- 🔥 CORREGIDO: SIN value="0" -->
                        <input type="hidden" asp-for="Tallas[i].Cantidad" class="cantidad-hidden" />
                    </td>

                    <td class="text-center">@item.CantidadPedida</td>

                    <td class="text-center">@item.CantidadDespachada</td>

                    <td class="text-center">
                        @if (sinPendiente)
                        {
                            <span class="badge bg-success">✔ Completado</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">@item.CantidadPendiente</span>
                        }
                    </td>

                   

                    <!-- CONTROL -->
                    <td class="text-center">

                        <input type="number"
                               class="form-control text-center cantidad-input"
                               min="0"
                               max="@item.CantidadPendiente"
                               step="1"
                               value="0"
                               data-index="@i"
                               style="width:90px;margin:auto;"
                               disabled="@(sinPendiente ? "disabled" : null)" />

                      

                    </td>
                </tr>
            }

        </tbody>
    </table>

    <!-- RESUMEN -->
    <div class="alert alert-secondary mt-3">
        <strong>Total a despachar:</strong>
        <span id="totalDocenas">0</span> docenas
    </div>

    <!-- BOTONES -->
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            ✔ Confirmar Despacho
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function syncHidden(index, value) {
            document.querySelectorAll(".cantidad-hidden")[index].value = value;
        }

        function recalcularTotalDocenas() {
            let total = 0;

            document.querySelectorAll(".cantidad-input").forEach(input => {
               total += parseInt(input.value) || 0;
            });

            document.getElementById("totalDocenas").innerText = total;
        }

        function validar(input) {

            let val = parseInt(input.value) || 0;

            if (val < 0) val = 0;

            let max = parseInt(input.max) || 0;

            if (val > max) val = max;

            input.value = val;

            let index = input.dataset.index;
            syncHidden(index, val);
        }

        // INPUT EVENTS
        document.querySelectorAll(".cantidad-input").forEach(input => {
            input.addEventListener("input", function () {
                validar(this);
                recalcularTotalDocenas();
            });
        });

       
       

        // INIT
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".cantidad-input").forEach((input, index) => {
                syncHidden(index, input.value);
            });

            recalcularTotalDocenas();
        });

    </script>
}

