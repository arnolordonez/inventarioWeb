@model IEnumerable<InventarioWEB.Models.Pedido>

@{
    ViewData["Title"] = "Despacho";
}

<h2 class="mb-4">📦 Seleccionar Pedido a despachar</h2>

<div class="alert alert-info">
    Seleccione un pedido disponible para realizar el proceso de despacho.
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-striped table-hover table-bordered align-middle">

                <thead class="table-dark text-center">
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Cliente</th>
                        <th style="width:140px;">Fecha</th>
                        <th style="width:140px;">Estado</th>
                        <th style="width:140px;">Tipo Venta</th>
                        <th style="width:150px;">Estado Pago</th>
                        <th style="width:150px;">Total</th>
                        <th style="width:120px;">Acción</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No hay pedidos disponibles para despacho
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="text-center fw-bold">
                                    @item.ID_Pedido
                                </td>

                                <!-- CLIENTE -->
                                <td>
                                    @(item.Cliente != null
                                        ? item.Cliente.Nombre + " " + item.Cliente.Apellido
                                        : "Sin cliente")
                                </td>

                                <!-- FECHA -->
                                <td class="text-center">
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <!-- ESTADO -->
                                <td class="text-center">

                                    @if (item.Estado == "NO DESPACHADO")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            NO DESPACHADO
                                        </span>
                                    }
                                    else if (item.Estado == "DESPACHADO")
                                    {
                                        <span class="badge bg-primary">
                                            DESPACHADO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Estado
                                        </span>
                                    }

                                </td>

                                <!-- TIPO VENTA -->
                                <td class="text-center">

                                    @if (item.TipoVenta == "CONTADO")
                                    {
                                        <span class="badge bg-success">
                                            CONTADO
                                        </span>
                                    }
                                    else if (item.TipoVenta == "CREDITO")
                                    {
                                        <span class="badge bg-danger">
                                            CRÉDITO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.TipoVenta
                                        </span>
                                    }

                                </td>

                                <!-- ESTADO PAGO -->
                                <td class="text-center">

                                    @if (item.EstadoPago == "PAGADO")
                                    {
                                        <span class="badge bg-success">
                                            PAGADO
                                        </span>
                                    }
                                    else if (item.EstadoPago == "ABONADO")
                                    {
                                        <span class="badge bg-info text-dark">
                                            ABONADO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.EstadoPago
                                        </span>
                                    }

                                </td>

                                <!-- TOTAL -->
                                <td class="text-end">
                                    @item.TotalVenta.ToString("C")
                                    <br />

                                    @if (item.TipoVenta == "CREDITO")
                                    {
                                        <small class="text-danger">
                                            Saldo: @item.Saldo.ToString("C")
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            Venta pagada
                                        </small>
                                    }

                                </td>

                                <!-- ACCIÓN -->
                                <td class="text-center">

                                    <a asp-action="Crear"
                                       asp-route-idPedido="@item.ID_Pedido"
                                       class="btn btn-sm btn-success">
                                        ➕ Despachar
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

        <a asp-controller="Auto" asp-action="Dashboard" class="btn btn-secondary">
            ⬅ Volver al Inicio
        </a>     

    </div>
</div>