@model IEnumerable<InventarioWEB.Models.Pedido>

@{
    ViewData["Title"] = "Seleccionar Pedido";
}

<h2 class="mb-4">📦 Seleccionar Pedido</h2>

<div class="alert alert-info">
    Selecciona un pedido <strong>PENDIENTE o PARCIAL</strong> para generar un despacho.
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-striped table-hover table-bordered align-middle">

                <thead class="table-dark text-center">
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Cliente</th>
                        <th style="width:140px;">Fecha</th>
                        <th style="width:120px;">Estado</th>
                        <th style="width:150px;">Total</th>
                        <th style="width:120px;">Acción</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No hay pedidos disponibles para despacho
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="text-center fw-bold">
                                    @item.ID_Pedido
                                </td>

                                <!-- CLIENTE -->
                                <td>
                                    @(item.Cliente != null
                                        ? item.Cliente.Nombre + " " + item.Cliente.Apellido
                                        : "Sin cliente")
                                    
                                  
                                </td>

                                <!-- FECHA -->
                                <td class="text-center">
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                    
                                   
                                </td>

                                <!-- ESTADO -->
                                <td class="text-center">

                                    @if (item.Estado == "PENDIENTE")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pendiente
                                        </span>
                                    }
                                    else if (item.Estado == "PARCIAL")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Parcial
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Estado
                                        </span>
                                    }

                                </td>

                                <!-- TOTAL -->
                                <td class="text-end">
                                    @item.TotalVenta.ToString("C")
                                    <br />
                                    <small class="text-muted">
                                        Total venta
                                    </small>
                                   
                                </td>

                                <!-- ACCIÓN -->
                                <td class="text-center">

                                    <a asp-action="Crear"
                                       asp-route-idPedido="@item.ID_Pedido"
                                       class="btn btn-sm btn-success">
                                        ➕ Despachar
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">
                ⬅ Volver
            </a>
        </div>

    </div>
</div>