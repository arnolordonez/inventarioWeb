@model InventarioWEB.ViewModels.Catalogos.Referencias.ReferenciasIndexVM

@{
    ViewData["Title"] = "Listado de Referencias";
}

<div class="container mt-4">

    <h2 class="text-primary fw-bold mb-4">
        <i class="bi bi-card-list"></i> @ViewData["Title"]
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a class="btn btn-success shadow-sm" asp-action="Crear">
            <i class="bi bi-plus-circle"></i> Crear Nueva Referencia
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">

            <table class="table table-hover table-striped table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:10%">ID</th>
                        <th style="width:45%">Descripción</th>
                        <th style="width:25%">Género</th>
                        <th style="width:20%" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Referencias != null && Model.Referencias.Any())
                    {
                        foreach (var item in Model.Referencias)
                        {
                            <tr>
                                <td>@item.ID_Referencias</td>
                                <td>@item.DescripReferencia</td>
                                <td>@item.Genero</td>
                                <td class="text-center">

                                    <a class="btn btn-sm btn-warning me-1"
                                       asp-action="Editar"
                                       asp-route-id="@item.ID_Referencias">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a class="btn btn-sm btn-danger"
                                       asp-action="Eliminar"
                                       asp-route-id="@item.ID_Referencias">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle"></i>
                                No hay referencias activas registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>
