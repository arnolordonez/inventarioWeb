@model InventarioWEB.ViewModels.Catalogos.Referencias.ReferenciaEditVM

@{
    ViewData["Title"] = "Editar Referencia";
}

<div class="container mt-4">

    <h2 class="text-primary fw-bold mb-4">@ViewData["Title"]</h2>

    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="ID_Referencias" type="hidden" />

        <div class="mb-3">
            <label asp-for="DescripReferencia" class="form-label"></label>
            <input asp-for="DescripReferencia" class="form-control" />
            <span asp-validation-for="DescripReferencia" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ID_Genero" class="form-label"></label>
            <select asp-for="ID_Genero"
                    class="form-select"
                    asp-items="Model.Generos">
                <option value="0">-- Seleccione un género --</option>
            </select>
            <span asp-validation-for="ID_Genero" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-pencil-square"></i> Guardar Cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
