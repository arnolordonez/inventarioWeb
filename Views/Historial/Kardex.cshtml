@model List<InventarioWEB.ViewModels.KardexViewModel>
@using System.Text.Json
@using InventarioWEB.ViewModels

@{
    ViewData["Title"] = "Kardex de Inventario";

    var modelData = Model ?? new List<KardexViewModel>();
    var hayDatos = modelData.Any();

    var totalEntradas = modelData.Sum(m => m.EntradaStock);
    var totalSalidas = modelData.Sum(m => m.SalidaStock);

   
    var graficaJson = JsonSerializer.Serialize(
        ViewBag.Grafica ?? new List<KardexGraficaViewModel>(),
        new JsonSerializerOptions
                {
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
                }
    );

    var filtros = ViewBag.Filtros;
}




<!-- 🟣 GRAFICA -->

<h2>📊 Kardex de Inventario</h2>

<div class="mb-4">
    <canvas id="graficaMovimientos" height="100"></canvas>
</div>

<script id="grafica-data" type="application/json">
    @Html.Raw(graficaJson)
</script>

<!-- 🟣 FILTROS -->

<form method="get" class="mb-3">

    <div class="row g-2 align-items-end">

        <div class="col-md-2">
            <label class="form-label">Producto</label>
            <input type="number"
                   name="idProducto"
                   class="form-control"
                   value="@(filtros?.idProducto ?? "")" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Color</label>
            <input type="text"
                   name="color"
                   class="form-control"
                   value="@(filtros?.color ?? "")" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Tela</label>
            <input type="text"
                   name="tela"
                   class="form-control"
                   value="@(filtros?.tela ?? "")" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Talla</label>
            <input type="text"
                   name="talla"
                   class="form-control"
                   value="@(filtros?.talla ?? "")" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Desde</label>
            <input type="date"
                   name="fechaInicio"
                   class="form-control"
                   value="@(filtros?.fechaInicio != null
                        ? ((DateTime)filtros.fechaInicio).ToString("yyyy-MM-dd")
                        : "")" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Hasta</label>
            <input type="date"
                   name="fechaFin"
                   class="form-control"
                   value="@(filtros?.fechaFin != null
                        ? ((DateTime)filtros.fechaFin).ToString("yyyy-MM-dd")
                        : "")" />
        </div>

    </div>

    <!-- 🟣 BOTONES -->
    <div class="mt-3">

        <button type="submit" class="btn btn-primary">
            🔍 Buscar
        </button>

        <a href="@Url.Action("Kardex")" class="btn btn-secondary">
            Limpiar
        </a>

        @if (hayDatos)
        {
            <a asp-action="ExportarExcel"
               asp-route-idProducto="@(filtros?.idProducto)"
               asp-route-color="@(filtros?.color)"
               asp-route-tela="@(filtros?.tela)"
               asp-route-talla="@(filtros?.talla)"
               asp-route-fechaInicio="@(filtros?.fechaInicio)"
               asp-route-fechaFin="@(filtros?.fechaFin)"
               class="btn btn-success">
                📄 Exportar Excel
            </a>
        }
        else
        {
            <button class="btn btn-secondary" disabled>
                📄 Exportar Excel
            </button>
        }

    </div>
</form>


<!-- RESUMEN (MEJORADO) -->

@if (hayDatos)
{
    <div class="mb-3">
        <strong>Entradas:</strong>
        <span class="text-success">@totalEntradas</span> |

        <strong>Salidas:</strong>
        <span class="text-danger">@totalSalidas</span>
    </div>
}
else
{
    <div class="alert alert-warning">
        No hay datos para los filtros seleccionados.
    </div>
}


<!--TABLA KARDEX (CORREGIDA Y LIMPIA) -->
<!-- TABLA KARDEX (CORREGIDA Y LIMPIA) -->
@if (hayDatos)
{
    <table class="table table-sm table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>Fecha</th>
                <th>Movimiento</th>
                <th>Documento</th>
                <th class="text-end">Entrada Stock</th>
                <th class="text-end">Salida Stock</th>
                <th class="text-end">Stock Actual</th>
                <th>Usuario</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in modelData)
            {
                <tr>
                    <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>

                    <td>
                        @if (item.EntradaStock > 0)
                        {
                            <span class="badge bg-success">🟢 Entrada</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">🔴 Salida</span>
                        }
                    </td>

                    <td>@item.DocumentoReferencia</td>

                    <td class="text-end text-success">
                        @(item.EntradaStock > 0 ? item.EntradaStock : "")
                    </td>

                    <td class="text-end text-danger">
                        @(item.SalidaStock > 0 ? item.SalidaStock : "")
                    </td>

                    <td class="text-end fw-bold">
                        @item.StockActual
                    </td>

                    <td>@item.UsuarioNombre</td>
                </tr>
            }
        </tbody>

    </table>
}


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const raw = JSON.parse(
        document.getElementById('grafica-data').textContent
    ) || [];

    const data = raw.sort((a, b) => new Date(a.fecha) - new Date(b.fecha));

    const labels = data.map(x =>
        new Date(x.fecha).toLocaleDateString()
    );

    const entradas = data.map(x => x.entradaStock ?? 0);
    const salidas = data.map(x => x.salidaStock ?? 0);

    // 📦 Stock acumulado desde fuente real
    let stock = 0;

    const stockData = data.map(x => {
        stock += (x.entradaStock - x.salidaStock);
        return stock;
    });

    new Chart(document.getElementById('graficaMovimientos'), {
        type: 'line',
        data: {
            labels,
            datasets: [
                {
                    label: 'Entrada Stock 🟢',
                    data: entradas,
                    borderColor: 'green',
                    fill: false
                },
                {
                    label: 'Salida Stock 🔴',
                    data: salidas,
                    borderColor: 'red',
                    fill: false
                },
                {
                    label: 'Stock Actual 📦',
                    data: stockData,
                    borderColor: 'blue',
                    tension: 0.3,
                    fill: false
                }
            ]
        },
        options: {
            responsive: true,
            interaction: {
                mode: 'index',
                intersect: false
            }
        }
    });
</script>

