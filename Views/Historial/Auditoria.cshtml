@model List<InventarioWEB.ViewModels.AuditoriaHistorialViewModel>

<h2>🔍 Auditoría de Historial de Inventario</h2>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Producto</th>
            <th>Tipo Movimiento</th>
            <th>Documento</th>
            <th>Stock Ant.</th>
            <th>Cantidad</th>
            <th>Stock Act.</th>
            <th>Estado</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.EsInconsistente ? "table-danger" : "")">
                <td>@item.NombreProducto</td>
                <td>@item.TipoMovimiento</td>
                <td>@item.DocumentoReferencia</td>
                <td>@item.StockAnterior</td>
                <td>@item.Cantidad</td>
                <td>@item.StockActual</td>
                <td>
                    @(item.EsInconsistente ? "⚠ Inconsistencia" : "OK")
                </td>
            </tr>
        }
    </tbody>
</table>