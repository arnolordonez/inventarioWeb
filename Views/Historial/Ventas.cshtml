@model List<InventarioWEB.Models.Pedido>

@{
    ViewData["Title"] = "Historial de Ventas";
}

<h2>🛒 Historial de Ventas</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Estado</th>
            <th>Estado Pago</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID_Pedido</td>
                <td>@item.Fecha.ToString("yyyy-MM-dd")</td>
                <td>@item.Cliente?.Nombre</td>
                <td>@item.Estado</td>
                <td>@item.EstadoPago</td>
                <td>@item.Total</td>
            </tr>
        }
    </tbody>
</table>