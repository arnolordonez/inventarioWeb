@model InventarioWEB.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var nombreUsuario = ViewBag.NombreUsuario ?? "Usuario";
}

<!-- ENCABEZADO -->
<div class="d-flex align-items-center mb-4">

    <img src="~/img/Logo.jpg" style="height:100px; margin-right:15px;" />

    <div>
        <h2 class="mb-0 fw-bold">Confecciones Indomable</h2>
        <small class="text-muted">Sistema de Inventario y Ventas</small>
    </div>

</div>

<!-- SALUDO -->
<div class="mb-3">
    <h4>Bienvenido, <strong>@nombreUsuario</strong></h4>
</div>

<!-- TARJETAS -->
<div class="row g-4">

    <!-- 💰 Ventas -->
    <div class="col-md-3">
        <div class="card shadow-sm border-start border-success border-4 h-100">
            <div class="card-body">
                <h6 class="text-muted">Ventas Hoy</h6>
                <h2 class="fw-bold text-success">
                    @Model.VentasHoy.ToString("C")
                </h2>
                <small>@Model.TotalDespachos despachos</small>
            </div>
        </div>
    </div>

    <!-- 📦 Stock -->
    <div class="col-md-3">
        <div class="card shadow-sm border-start border-success border-4 h-100">
            <div class="card-body">
                <h6 class="text-muted">Stock disponible</h6>
                <h2 class="fw-bold">@Model.StockTotal.ToString("N0")</h2>
               
            </div>
        </div>
    </div>

    <!-- ⚠ Stock bajo -->
    <div class="col-md-3">
        <div class="card shadow-sm border-start border-success border-4 h-100">
            <div class="card-body text-center">
               <h6 class="text-muted">Stock bajo</h6>
                <h2 class="fw-bold text-warning">@Model.StockBajo.ToString("N0")</h2>
                
                <small>Requiere atención</small>
            </div>
        </div>
    </div>

    <!-- 🧵 Producción -->
    <div class="col-md-3">
        <div class="card shadow-sm border-start border-success border-4 h-100">    
            <div class="card-body text-center">
                <h6 class="text-muted">Producción activa</h6>
                <h2 class="fw-bold text-danger">@Model.ProduccionActiva.ToString("N0")</h2>
              
            </div>
        </div>
    </div>

</div>

<!-- MENSAJE INFERIOR -->
<div class="card shadow-sm mt-4 p-4">
    <h5>Panel de control</h5>
    <p>
        Aquí puedes visualizar el estado actual del negocio: ventas del día,
        inventario disponible, alertas de stock y producción en curso.
    </p>
</div>

