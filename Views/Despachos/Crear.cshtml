@model InventarioWEB.ViewModels.DespachoTallaViewModel

@{
    ViewData["Title"] = "Crear Despacho";
}

<h2 class="mb-4">📦 Crear Despacho</h2>

<div class="alert alert-info">
    <strong>Pedido:</strong> #@Model.ID_Pedido <br />
    <strong>Total Pedido:</strong>
    @Model.TotalUnidadesPedido unidades
    (@Model.TotalDocenasPedido docenas)
</div>

<div class="alert alert-warning">
    ⚠ El despacho debe ser múltiplo de <strong>12 unidades (docenas)</strong>.
</div>

<form asp-action="Crear" method="post">

    <input type="hidden" asp-for="ID_Pedido" />

    <!-- ERRORES -->
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <table class="table table-bordered align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Talla</th>
                <th>Pedido</th>
                <th>Despachado</th>
                <th>Pendiente</th>
                <th style="width:150px;">Despachar</th>
            </tr>
        </thead>

        <tbody>

            @for (int i = 0; i < Model.Tallas.Count; i++)
            {
                var item = Model.Tallas[i];
                var sinPendiente = item.CantidadPendiente <= 0;

                <tr>

                    <!-- TALLA -->
                    <td>
                        <strong>@item.Talla</strong>
                        <input type="hidden" asp-for="Tallas[i].ID_Producto" />
                    </td>

                    <!-- PEDIDO -->
                    <td class="text-center">
                        @item.CantidadPedida
                    </td>

                    <!-- DESPACHADO -->
                    <td class="text-center">
                        @item.CantidadDespachada
                    </td>

                    <!-- PENDIENTE -->
                    <td class="text-center">
                        @if (sinPendiente)
                        {
                            <span class="badge bg-success">Completado</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                @item.CantidadPendiente
                            </span>
                        }
                    </td>

                    <!-- INPUT DESPACHAR -->
                    <td class="text-center">

                        @if (sinPendiente)
                        {
                            <input asp-for="Tallas[i].Cantidad"
                                   class="form-control text-center"
                                   type="number"
                                   min="0"
                                   max="@item.CantidadPendiente"
                                   style="width:90px;margin:auto;"
                                   readonly />
                        }
                        else
                        {
                            <input asp-for="Tallas[i].Cantidad"
                                   class="form-control text-center cantidad-input"
                                   type="number"
                                   min="0"
                                   max="@item.CantidadPendiente"
                                   style="width:90px;margin:auto;" />
                        }

                    </td>

                </tr>
            }

        </tbody>
    </table>

    <!-- RESUMEN -->
    <div class="alert alert-secondary">

        <strong>Total a despachar:</strong>

        <span id="totalUnidades">@Model.TotalUnidades</span> unidades
        (<span id="totalDocenas">@Model.TotalDocenas</span> docenas)

    </div>

    <!-- BOTONES -->
    <div class="mt-3 d-flex gap-2">

        <button type="submit" class="btn btn-primary">
            ✔ Confirmar Despacho
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function recalcularTotal() {

            let total = 0;

            document.querySelectorAll(".cantidad-input").forEach(input => {

                let val = parseInt(input.value) || 0;

                total += val;

            });

            let docenas = Math.floor(total / 12);

            document.getElementById("totalUnidades").innerText = total;
            document.getElementById("totalDocenas").innerText = docenas;

        }

        // detectar cambios
        document.querySelectorAll(".cantidad-input")
        .forEach(input => {

            input.addEventListener("input", recalcularTotal);

        });

    </script>

}