@model InventarioWEB.ViewModels.Catalogos.Generos.GeneroEditVM

@{
    ViewData["Title"] = "Editar Género";
    Layout = "_Layout";
}

<div class="mt-4">

    <!-- ============================
         TÍTULO
    ============================ -->
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="fw-bold text-primary">
                <i class="bi bi-pencil-square me-2"></i>
                Editar Género
            </h3>
            <p class="text-muted">
                Modifique la descripción del género seleccionado.
            </p>
        </div>
    </div>

    <hr />

    <!-- ============================
         FORMULARIO
    ============================ -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Editar" method="post">
                <input type="hidden" asp-for="ID_Genero" />

                <div class="mb-3">
                    <label asp-for="DescripGenero" class="form-label fw-semibold"></label>
                    <input asp-for="DescripGenero"
                           class="form-control"
                           autocomplete="off" />
                    <span asp-validation-for="DescripGenero"
                          class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Volver
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Guardar cambios
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
