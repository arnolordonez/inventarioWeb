@model InventarioWEB.ViewModels.VentaVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Punto de Venta";
}

<div class="container mt-4">

    <h4 class="mb-4">🛒 Punto de Venta</h4>

    <!-- 🔹 CLIENTE -->
    <div class="card p-3 mb-3">

        <label class="form-label fw-bold">Cliente</label>

        <div class="input-group">
            <input type="text" id="txtBuscarCliente" class="form-control"
                   placeholder="Buscar cliente por nombre o cedula">

            <button class="btn btn-primary" type="button" onclick="buscarCliente()">
                🔍 Buscar
            </button>
        </div>

        <div id="listaClientes" class="mt-3"></div>

        <input type="hidden" id="ID_Cliente" />

        <!-- 🔥 CORREGIDO: quitar d-none -->
        <small id="clienteError" class="text-danger" style="display:none;">
            Debe seleccionar un cliente existente
        </small>

        <!-- 🔽 INFORMACIÓN CLIENTE -->
        <!-- 🔥 CORREGIDO: quitar d-none -->
        <div id="clienteInfo" class="mt-3" style="display:none;">

            <div id="clienteAlert" class="alert p-3 mb-2">

                <div class="d-flex justify-content-between align-items-center">
                    <strong>Cliente seleccionado</strong>

                    <button type="button" id="btnCambiarCliente"
                            class="btn btn-sm btn-warning"
                            onclick="cambiarCliente()">
                        Cambiar
                    </button>
                </div>

                <hr class="my-2" />

                <div class="row">

                    <div class="col-md-6">
                        <b>Nombre:</b>
                        <div id="cliNombre" class="text-primary"></div>
                    </div>

                    <div class="col-md-6">
                        <b>Cedula:</b>
                        <div>
                            <span id="cliCedula"></span>
                            &nbsp;&nbsp;
                            <span id="cliEstado" class="fw-bold"></span>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- 🔹 FILTROS -->
    <div class="card p-3 mb-3">
        <h6>Filtros</h6>

        <div class="row">

            <div class="col-md-3">
                <label>Genero</label>
                <select id="genero" class="form-control">
                    <option value="">Cargando...</option>
                </select>
            </div>

            <div class="col-md-3">
                <label>Referencia</label>
                <select id="referencia" class="form-control">
                    <option value="">Seleccione referencia</option>
                </select>
            </div>

            <div class="col-md-2">
                <label>Tela</label>
                <select id="tela" class="form-control">
                    <option value="">Cargando...</option>
                </select>
            </div>

            <div class="col-md-2">
                <label>Color</label>
                <select id="color" class="form-control">
                    <option value="">Cargando...</option>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" onclick="cargarMatriz()">
                    Buscar
                </button>
            </div>

        </div>
    </div>

    <!-- 🔹 DEBUG -->
    <div id="debugCombos" class="text-danger mt-2"></div>

    <!-- 🔹 MATRIZ -->
    <div class="card p-3 mb-3">
        <h6>Matriz de tallas</h6>

        <!-- 🔥 AYUDA VISUAL CLAVE -->
        <small class="text-muted d-block mb-2">
            ⚠️ Todas las cantidades se manejan en docenas (1 = 1 docena)
        </small>

        <div id="matriz"></div>
    </div>

    <!-- 🔹 CARRITO -->
    <div class="card p-3 mb-3">
        <h6>Carrito</h6>

        <table class="table table-bordered" id="carrito">
            <thead class="table-light">
                <tr>
                    <th>Producto</th>
                    <th>Docenas</th>
                    <th>Precio Docena</th>
                    <th>Subtotal</th>
                    <th style="width: 50px;"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

   
    <!-- 🔹 TOTALES -->
    <div class="card p-3 mb-3">
        <div class="row g-3">

            <div class="col-md-3">
                <label class="form-label">Total sin IVA</label>
                <input type="number" id="totalSinIva" class="form-control" readonly />
            </div>

            <div class="col-md-3">
                <label class="form-label">Total Venta (con IVA)</label>
                <input type="number" id="totalVenta" class="form-control" readonly />
            </div>

            <div class="col-md-3">
                <label class="form-label">Tipo de venta</label>
                <select id="tipoVenta" class="form-control">
                    <option value="CONTADO">Contado</option>
                    <option value="CREDITO">Crédito</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Abono inicial (sobre total con IVA)</label>
                <input type="number" id="abonoInicial" class="form-control" min="0" step="0.01" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Método de pago</label>
                <select id="metodoPago" class="form-control">
                    <option value="">Seleccione...</option>
                </select>
            </div>

        </div>
    </div>
    <!-- 🔹 GUARDAR -->
    <button id="btnGuardarVenta" class="btn btn-success w-100" onclick="guardarVenta()">
        💾 Guardar Venta
    </button>

</div>

@section Scripts {

    <!-- 🔥 CRÍTICO: ASEGURAR jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- 🔥 TU JS DESPUÉS -->
    <script src="~/js/ventas.js?v=4"></script>

}