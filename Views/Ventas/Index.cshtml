@model InventarioWEB.ViewModels.VentaVM
@{
    ViewData["Title"] = "Punto de Venta";
}

<div class="container mt-4">

    <h3 class="mb-4">🛒 Punto de Venta</h3>

    <!-- ========================= -->
    <!-- 🔹 CLIENTE -->
    <!-- ========================= -->
    <div class="card p-3 mb-3">
        <label>Buscar Cliente</label>
