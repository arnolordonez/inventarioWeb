        <input type="hidden" id="ID_Cliente" />
    </div>

    <!-- ========================= -->
    <!-- 🔹 FILTROS -->
    <!-- ========================= -->
    <div class="card p-3 mb-3">
        <div class="row">

            <div class="col-md-3">
                <label>Género</label>
                <select id="genero" class="form-control">
                    <option value="">Seleccione</option>
                    @foreach (var g in ViewBag.Generos)
                    {
                        <option value="@g.Value">@g.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label>Referencia</label>
                <select id="referencia" class="form-control">
                    <option value="">Seleccione</option>
                </select>
            </div>

            <div class="col-md-3">
                <label>Tela</label>
                <select id="tela" class="form-control">
                    <option value="">Seleccione</option>
                    @foreach (var t in ViewBag.Telas)
                    {
                        <option value="@t.Value">@t.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label>Color</label>
                <select id="color" class="form-control">
                    <option value="">Seleccione</option>
                    @foreach (var c in ViewBag.Colores)
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                </select>
            </div>

        </div>

        <div class="mt-3">
            <button class="btn btn-primary" onclick="cargarMatriz()">
                🔍 Buscar
            </button>
        </div>
    </div>

    <!-- ========================= -->
    <!-- 🔹 MATRIZ -->
    <!-- ========================= -->
    <div class="card p-3 mb-3">
        <h5>Matriz de Tallas</h5>
        <div id="matriz"></div>
    </div>

    <!-- ========================= -->
    <!-- 🔹 CARRITO -->
    <!-- ========================= -->
    <div class="card p-3 mb-3">
        <h5>Carrito</h5>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>ID Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="carrito"></tbody>
        </table>

        <h4 class="text-end">
            Total: $<span id="total">0</span>
        </h4>
    </div>

    <!-- ========================= -->
    <!-- 🔹 GUARDAR -->
    <!-- ========================= -->
    <button class="btn btn-success w-100" onclick="guardarVenta()">
        💾 Guardar Venta
    </button>

</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="~/js/ventas.js"></script>
}
