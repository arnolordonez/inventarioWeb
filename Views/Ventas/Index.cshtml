@model InventarioWEB.ViewModels.VentaVM

@{
    ViewData["Title"] = "Punto de Venta";
}

<div class="container mt-4">

    <h4 class="mb-4">🛒 Punto de Venta</h4>

    <!-- ===================================================== -->
    <!-- 🔹 CLIENTE -->
    <!-- ===================================================== -->
    <div class="card p-3 mb-3">
        <label>Cliente</label>

        <input type="text" id="clienteBusqueda" class="form-control"
               placeholder="Buscar por nombre o documento..." autocomplete="off" />

        <input type="hidden" id="ID_Cliente" />

        <small id="clienteSeleccionado" class="text-success"></small>

        <button type="button" class="btn btn-sm btn-warning mt-2"
                onclick="cambiarCliente()">
            Cambiar cliente
        </button>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 FILTROS (CLAVE DEL SISTEMA) -->
    <!-- ===================================================== -->
    <div class="card p-3 mb-3">
        <h6>Filtros</h6>

        <div class="row">

            <div class="col-md-3">
                <label>Género</label>
                <select id="genero" class="form-control"></select>
            </div>

            <div class="col-md-3">
                <label>Referencia</label>
                <select id="referencia" class="form-control"></select>
            </div>

            <div class="col-md-2">
                <label>Tela</label>
                <select id="tela" class="form-control"></select>
            </div>

            <div class="col-md-2">
                <label>Color</label>
                <select id="color" class="form-control"></select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100"
                        onclick="cargarMatriz()">
                    Buscar
                </button>
            </div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 MATRIZ DE TALLAS -->
    <!-- ===================================================== -->
    <div class="card p-3 mb-3">
        <h6>Matriz de tallas</h6>
        <div id="matriz"></div>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 CARRITO -->
    <!-- ===================================================== -->
    <div class="card p-3 mb-3">
        <h6>Carrito</h6>

        <table class="table table-bordered" id="carrito">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Talla</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <!-- ===================================================== -->
    <!-- 🔹 TOTALES -->
    <!-- ===================================================== -->
    <div class="card p-3 mb-3">

        <div class="row">

            <div class="col-md-4">
                <label>Total Venta</label>
                <input type="number" id="totalVenta" class="form-control" readonly />
            </div>

            <div class="col-md-4">
                <label>Abono inicial</label>
                <input type="number" id="abonoInicial" class="form-control" />
            </div>

            <div class="col-md-4">
                <label>Método de pago</label>
                <select id="metodoPago" class="form-control"></select>
            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- 🔹 GUARDAR -->
    <!-- ===================================================== -->
    <button class="btn btn-success w-100" onclick="guardarVenta()">
        💾 Guardar Venta
    </button>

</div>

@section Scripts {

    <!-- jQuery UI (autocomplete) -->
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script src="~/js/ventas.js"></script>
}







