@model InventarioWEB.ViewModels.VentaDetalleVM

<div class="modal fade" id="modalAbono">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Registrar Abono</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="ID_Pedido" value="@Model.ID_Pedido" />

                <div class="mb-2">
                    <label>Monto</label>
                    <input type="number" id="Monto" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Método Pago</label>
                    <select id="MetodoPago" class="form-control">
                        <option value="1">Efectivo</option>
                        <option value="2">Transferencia</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" onclick="guardarAbono()">
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    function guardarAbono() {
        const data = {
            ID_Pedido: document.getElementById("ID_Pedido").value,
            Monto: document.getElementById("Monto").value,
            ID_MetodoPago: document.getElementById("MetodoPago").value
        };

        fetch('/Abonos/Crear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(() => location.reload());
    }
</script>